+//! Contract for `Ledger::verify` on an empty record slice, as settled by beta
+//! in thread contract/ledger-verify:
+//!
+//! [A1] For an empty record slice, Ledger::verify returns Ok(genesis), since the
+//! loop never runs and the head is still the genesis digest. If the chain is
+//! broken, it returns Err(LedgerError::Chain) at the first record whose prev_root
+//! does not match the running head or whose recomputed compute_root() does not
+//! equal its stored root; it does not return the partial head.
+
+use crumbs::ledger::{genesis, Ledger};
+use crumbs::provenance::Lane;
+
+#[test]
+fn verify_empty_slice_returns_genesis() {
+    for lane in [Lane::Main, Lane::CleanRoom] {
+        let g = genesis(lane, "run-empty");
+        assert_eq!(Ledger::verify(g, &[]), Ok(g));
+    }
+}
