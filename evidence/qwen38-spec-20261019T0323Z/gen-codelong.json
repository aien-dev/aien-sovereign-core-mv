  "k0_text": "```c\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ctype.h>\n\n/*\n * Word frequency counter using a custom hash table.\n * Reads lines from stdin, tokenizes into words, counts frequencies,\n * and prints the 10 most frequent words.\n */\n\n/* Maximum number of distinct words we can store */\n#define MAX_WORDS 100000\n\n/* Initial capacity of the hash table (must be a power of 2 for simple modulo) */\n#define INITIAL_CAPACITY 1024\n\n/* Number of top words to print */\n#define TOP_N 10\n\n/*\n * Hash table entry: stores a word and its frequency.\n * Each bucket is a linked list of entries to handle collisions.\n */\ntypedef struct Entry {\n    char *word;\n    int count;\n    struct Entry *next;\n} Entry;\n\n/*\n * Hash table structure: array of buckets, each pointing to a linked list.\n */\ntypedef struct {\n    Entry **buckets;\n    int capacity;\n    int size; /* number of distinct words */\n} HashTable;\n\n/*\n * Compute a hash value for a",
