# The omega GPU engine C ABI (libomega_gpu.a) that aien-omega-gpu mirrors in src/ffi.rs.
# Checked from both sides: tests/abi_manifest.rs (Rust declarations, every build) and build.rs
# (pinned C headers, compiled layout probe, archive symbols).
# Format: aien-abi-conformance src/manifest.rs. Regenerate the fact lines from Rust with
#   AIEN_ABI_BLESS=1 cargo test -p aien-omega-gpu --test abi_manifest
# only together with the omega.lock change that makes the C side agree.
abi omega_gpu 1
header src/omega_gpu_matmul_api.h
header src/omega_gpu_session.h
header src/omega_gpu_serving.h
header src/omega_gpu_elementwise_api.h
header src/omega_gpu_attention_api.h
struct OmegaGpuMatmulInfo 160 8
field OmegaGpuMatmulInfo m 0 4 u32 1
field OmegaGpuMatmulInfo k 4 4 u32 1
field OmegaGpuMatmulInfo n 8 4 u32 1
field OmegaGpuMatmulInfo padded_m 12 4 u32 1
field OmegaGpuMatmulInfo padded_n 16 4 u32 1
field OmegaGpuMatmulInfo k_slices 20 4 u32 1
field OmegaGpuMatmulInfo chip_calls 24 4 u32 1
field OmegaGpuMatmulInfo rows_per_call 28 4 u32 1
field OmegaGpuMatmulInfo elapsed_ns 32 8 u64 1
field OmegaGpuMatmulInfo max_abs_err 40 4 f32 1
field OmegaGpuMatmulInfo max_rel_err 44 4 f32 1
field OmegaGpuMatmulInfo mismatch_count 48 8 u64 1
field OmegaGpuMatmulInfo parity_verified 56 1 bool 1
field OmegaGpuMatmulInfo completion_marker 60 4 u32 1
field OmegaGpuMatmulInfo kernel_cache_hit 64 1 bool 1
field OmegaGpuMatmulInfo target_chip 65 64 c_char 64
field OmegaGpuMatmulInfo sm_architecture 132 4 u32 1
field OmegaGpuMatmulInfo grid_x 136 4 u32 1
field OmegaGpuMatmulInfo grid_y 140 4 u32 1
field OmegaGpuMatmulInfo padded_k 144 4 u32 1
field OmegaGpuMatmulInfo resident 148 1 bool 1
field OmegaGpuMatmulInfo oracle_ran 149 1 bool 1
field OmegaGpuMatmulInfo call_ns 152 8 u64 1
struct OmegaGpuAllocStats 40 8
field OmegaGpuAllocStats allocs 0 8 u64 1
field OmegaGpuAllocStats alloc_bytes 8 8 u64 1
field OmegaGpuAllocStats alloc_failures 16 8 u64 1
field OmegaGpuAllocStats frees 24 8 u64 1
field OmegaGpuAllocStats stale_refusals 32 8 u64 1
struct OmegaGpuServingBounds 44 4
field OmegaGpuServingBounds max_context 0 4 u32 1
field OmegaGpuServingBounds max_seqs 4 4 u32 1
field OmegaGpuServingBounds num_q_heads 8 4 u32 1
field OmegaGpuServingBounds num_kv_heads 12 4 u32 1
field OmegaGpuServingBounds head_dim 16 4 u32 1
field OmegaGpuServingBounds kv_block_size 20 4 u32 1
field OmegaGpuServingBounds max_rows 24 4 u32 1
field OmegaGpuServingBounds max_k 28 4 u32 1
field OmegaGpuServingBounds max_n 32 4 u32 1
field OmegaGpuServingBounds max_n_one_row 36 4 u32 1
field OmegaGpuServingBounds kernel_slots 40 4 u32 1
struct OmegaGpuEwInfo 120 8
field OmegaGpuEwInfo chip_calls 0 4 u32 1
field OmegaGpuEwInfo elapsed_ns 8 8 u64 1
field OmegaGpuEwInfo completion_marker 16 4 u32 1
field OmegaGpuEwInfo unwritten_words 20 4 u32 1
field OmegaGpuEwInfo kernel_cache_hit 24 1 bool 1
field OmegaGpuEwInfo gpr_count 28 4 u32 1
field OmegaGpuEwInfo insn_count 32 4 u32 1
field OmegaGpuEwInfo threads_per_cta 36 4 u32 1
field OmegaGpuEwInfo ctas_last_launch 40 4 u32 1
field OmegaGpuEwInfo target_chip 44 64 c_char 64
field OmegaGpuEwInfo sm_architecture 108 4 u32 1
field OmegaGpuEwInfo call_ns 112 8 u64 1
struct OmegaGpuAttnInfo 176 8
field OmegaGpuAttnInfo chip_calls 0 4 u32 1
field OmegaGpuAttnInfo elapsed_ns 8 8 u64 1
field OmegaGpuAttnInfo call_ns 16 8 u64 1
field OmegaGpuAttnInfo completion_marker 24 4 u32 1
field OmegaGpuAttnInfo unwritten_words 28 4 u32 1
field OmegaGpuAttnInfo gpr_count 32 4 u32 1
field OmegaGpuAttnInfo insn_count 36 4 u32 1
field OmegaGpuAttnInfo kernel_cache_hit 40 1 bool 1
field OmegaGpuAttnInfo ctas_last_launch 44 4 u32 1
field OmegaGpuAttnInfo threads_per_cta 48 4 u32 1
field OmegaGpuAttnInfo target_chip 52 64 c_char 64
field OmegaGpuAttnInfo sm_architecture 116 4 u32 1
field OmegaGpuAttnInfo kv_bytes_staged 120 8 u64 1
field OmegaGpuAttnInfo kv_bytes_naive 128 8 u64 1
field OmegaGpuAttnInfo kv_blocks_logical 136 4 u32 1
field OmegaGpuAttnInfo kv_blocks_unique 140 4 u32 1
field OmegaGpuAttnInfo q_bytes 144 8 u64 1
field OmegaGpuAttnInfo tab_bytes 152 8 u64 1
field OmegaGpuAttnInfo out_bytes 160 8 u64 1
field OmegaGpuAttnInfo kv_source 168 4 u32 1
struct OmegaGpuKvLayout 64 8
field OmegaGpuKvLayout block_stride_bytes 0 8 u64 1
field OmegaGpuKvLayout layer_stride_bytes 8 8 u64 1
field OmegaGpuKvLayout kv_plane_stride_bytes 16 8 u64 1
field OmegaGpuKvLayout token_stride_bytes 24 8 u64 1
field OmegaGpuKvLayout head_stride_bytes 32 8 u64 1
field OmegaGpuKvLayout pool_bytes 40 8 u64 1
field OmegaGpuKvLayout num_blocks 48 4 u32 1
field OmegaGpuKvLayout num_layers 52 4 u32 1
field OmegaGpuKvLayout block_size 56 4 u32 1
const OMEGA_GPU_MATMUL_OK 0
const OMEGA_GPU_MATMUL_BAD_ARGS -1
const OMEGA_GPU_MATMUL_TOO_LARGE -2
const OMEGA_GPU_MATMUL_CODEGEN_FAIL -3
const OMEGA_GPU_MATMUL_CHIP_FAIL -4
const OMEGA_GPU_MATMUL_PARITY_FAIL -5
const OMEGA_GPU_MATMUL_TILE_M 16
const OMEGA_GPU_MATMUL_TILE_N 8
const OMEGA_GPU_MATMUL_TILE_K 16
const OMEGA_GPU_MATMUL_MAX_CTAS 64
const OMEGA_GPU_EW_OK 0
const OMEGA_GPU_EW_BAD_ARGS -1
const OMEGA_GPU_EW_TOO_LARGE -2
const OMEGA_GPU_EW_CODEGEN_FAIL -3
const OMEGA_GPU_EW_CHIP_FAIL -4
const OMEGA_GPU_EW_UNWRITTEN -5
const OMEGA_GPU_ATTN_OK 0
const OMEGA_GPU_ATTN_BAD_ARGS -1
const OMEGA_GPU_ATTN_TOO_LARGE -2
const OMEGA_GPU_ATTN_CODEGEN_FAIL -3
const OMEGA_GPU_ATTN_CHIP_FAIL -4
const OMEGA_GPU_ATTN_UNWRITTEN -5
const OMEGA_GPU_ATTN_KV_STAGED 0
fn omega_gpu_matmul_bf16 fn(u32, u32, u32, *const u16, *const u16, *mut f32, *mut OmegaGpuMatmulInfo) -> i32
fn omega_gpu_matmul_f32 fn(u32, u32, u32, *const f32, *const f32, *mut f32, *mut OmegaGpuMatmulInfo) -> i32
fn omega_gpu_matmul_rc_name fn(i32) -> *const c_char
fn omega_gpu_matmul_cache_clear fn() -> ()
fn omega_gpu_tensor_upload_bf16 fn(u32, u32, *const u16, *mut *mut OmegaGpuTensor) -> i32
fn omega_gpu_tensor_upload_f32 fn(u32, u32, *const f32, *mut *mut OmegaGpuTensor) -> i32
fn omega_gpu_tensor_free fn(*mut OmegaGpuTensor) -> ()
fn omega_gpu_tensor_shape fn(*const OmegaGpuTensor, *mut u32, *mut u32) -> ()
fn omega_gpu_matmul_resident_bf16 fn(u32, *const u16, *const OmegaGpuTensor, *mut f32, *mut OmegaGpuMatmulInfo) -> i32
fn omega_gpu_matmul_resident_f32 fn(u32, *const f32, *const OmegaGpuTensor, *mut f32, *mut OmegaGpuMatmulInfo) -> i32
fn omega_gpu_matmul_last_error fn() -> *const c_char
fn omega_gpu_matmul_is_blocked fn() -> i32
fn omega_gpu_device_close fn() -> ()
fn omega_gpu_matmul_set_cta_budget fn(u32) -> ()
fn omega_gpu_matmul_cta_budget fn() -> u32
fn omega_gpu_session_set_spin_us fn(u32) -> i32
fn omega_gpu_session_spin_us fn() -> u32
fn omega_gpu_reserve_serving fn(*const OmegaGpuServingBounds) -> i32
fn omega_gpu_serving_release fn() -> ()
fn omega_gpu_matmul_prepare fn(u32, u32, u32) -> i32
fn omega_gpu_serving_seal fn() -> ()
fn omega_gpu_session_alloc_stats fn(*mut OmegaGpuAllocStats) -> ()
fn omega_gpu_rmsnorm_f32 fn(u32, u32, *const f32, *const f32, f32, *mut f32, *mut OmegaGpuEwInfo) -> i32
fn omega_gpu_rope_f32 fn(u32, u32, *const f32, *const f32, *const f32, *mut f32, *mut OmegaGpuEwInfo) -> i32
fn omega_gpu_swiglu_f32 fn(u32, *const f32, *const f32, *mut f32, *mut OmegaGpuEwInfo) -> i32
fn omega_gpu_elementwise_rc_name fn(i32) -> *const c_char
fn omega_gpu_gqa_attention_f32 fn(*const f32, *const f32, *const f32, u32, u32, u32, u32, *mut f32, *mut OmegaGpuAttnInfo) -> i32
fn omega_gpu_gqa_attention_rows_f32 fn(*const f32, *const f32, *const f32, u32, u32, u32, u32, u32, *mut f32, *mut OmegaGpuAttnInfo) -> i32
fn omega_gpu_attention_pool_alloc fn(usize, *mut *mut c_void) -> i32
fn omega_gpu_attention_pool_free fn() -> ()
fn omega_gpu_paged_attention_bf16 fn(*const f32, *const c_void, *const OmegaGpuKvLayout, *const u32, u32, u32, u32, u32, u32, u32, *mut f32, *mut OmegaGpuAttnInfo) -> i32
fn omega_gpu_paged_attention_batch_bf16 fn(*const f32, *const c_void, *const OmegaGpuKvLayout, *const i32, *const i32, u32, u32, u32, u32, u32, u32, *mut f32, *mut OmegaGpuAttnInfo) -> i32
fn omega_gpu_attention_rc_name fn(i32) -> *const c_char
fn omega_gpu_attention_last_error fn() -> *const c_char
