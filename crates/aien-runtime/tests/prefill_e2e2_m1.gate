# crates/aien-runtime/tests/prefill_e2e2_m1.gate
# PREFILL-E2E-2 mutant m1 (the append replays the whole earlier context). Same as the forge mutant leg for m1:
# apply prefill_e2e2_mutants/mutant_m1.patch, run the ignored test, restore the
# tree. PASS means the mutant was killed: the test failed and printed
# RECOMPUTE_ALL_VIOLATION. The driver is prefill_e2e2_run.sh.
gate: PREFILL-E2E-2-M1
manifest_version: 1
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - crates/aien-runtime/
  - crates/aien-platform/
  - crates/aien-platform-linux/
  - crates/aien-kv-cache/
  - crates/aien-scheduler/
  - crates/aien-abi-core/
  - crates/aien-inference-abi/
  - crates/aien-security/
  - crates/cortex-rs/
run:
  exec: crates/aien-runtime/tests/prefill_e2e2_run.sh
  args: ["mutant", "m1", "RECOMPUTE_ALL_VIOLATION"]
expects:
  exit: 0
  observe: ["mutant_killed == true", "mutant_test_rc != 0"]
  verdict: PASS
timeout: 60m
checks:
  - clean_tree_after
outside_inputs:
  - ~/models/TinyLlama-1.1B-Chat-v1.0/
cache: inputs_complete
