# crates/aien-runtime/tests/prefill_e2e2.gate
# PREFILL-E2E-2 (sovereign-core #165): append 24 tokens to a shared prefilled
# prefix; only the new positions are computed. Same chain as the first forge
# line for PE2E2-A: fmt check, clippy, then the ignored real-checkpoint test
# (TinyLlama-1.1B on the host CPU, release mode). GB10 is not needed.
gate: PREFILL-E2E-2
manifest_version: 1
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - crates/
  - tools/
  # Read outside crates/ (aien-audit-inputs, L335): the C1 acceptance file at
  # run time, two campaign files compiled in by include_str!, and omega.lock
  # through a build script.
  - docs/campaigns/c1/
  - docs/campaigns/next-phase-1/
  - omega.lock
run:
  exec: crates/aien-runtime/tests/prefill_e2e2_run.sh
  args: ["main"]
expects:
  exit: 0
  observe: ["fmt_rc == 0", "clippy_rc == 0", "test_rc == 0"]
  verdict: PASS
timeout: 120m
checks:
  - clean_tree_after
outside_inputs:
  - ~/models/TinyLlama-1.1B-Chat-v1.0/
cache: inputs_complete
