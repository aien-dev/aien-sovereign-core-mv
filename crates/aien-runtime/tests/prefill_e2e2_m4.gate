# crates/aien-runtime/tests/prefill_e2e2_m4.gate
# inputs: the crates cargo compiles for aien-runtime and its tests (cargo metadata, L335), every member manifest and the
# target listings cargo reads to load the workspace; outside_inputs: the checkpoint. Audited with aien-audit-inputs.
# PREFILL-E2E-2 mutant m4 (the dense prefix rebuilt from the pool reads the wrong layer). Same as the forge mutant leg for m4:
# apply prefill_e2e2_mutants/mutant_m4.patch, run the ignored test, restore the
# tree. PASS means the mutant was killed: the test failed and printed
# KV_PARITY_VIOLATION. The driver is prefill_e2e2_run.sh.
gate: PREFILL-E2E-2-M4
manifest_version: 1
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - crates/aien-abi-conformance/
  - crates/aien-abi-core/
  - crates/aien-allen/
  - crates/aien-allen-memory/
  - crates/aien-allen-profile/
  - crates/aien-inference-abi/
  - crates/aien-kv-cache/
  - crates/aien-kv-store/
  - crates/aien-localhttp/
  - crates/aien-omega-bf16/
  - crates/aien-omega-compose/
  - crates/aien-omega-dattn/
  - crates/aien-omega-dgraph/
  - crates/aien-omega-fp8/
  - crates/aien-omega-gpu/
  - crates/aien-omega-moe/
  - crates/aien-omega-pf/
  - crates/aien-omega-router/
  - crates/aien-platform/
  - crates/aien-platform-linux/
  - crates/aien-runtime/
  - crates/aien-scheduler/
  - crates/aien-security/
  - crates/aien-trace/
  - crates/cortex-rs/
  - crates/*/Cargo.toml
  - tools/*/Cargo.toml
listed:
  - crates/*
  - crates/*/src
  - crates/*/src/bin
  - crates/*/tests
  - crates/*/examples
  - crates/*/benches
  - tools/*
  - tools/*/src
  - tools/*/src/bin
  - tools/*/tests
  - tools/*/examples
  - tools/*/benches
run:
  exec: crates/aien-runtime/tests/prefill_e2e2_run.sh
  args: ["mutant", "m4", "KV_PARITY_VIOLATION"]
expects:
  exit: 0
  observe: ["mutant_killed == true", "mutant_test_rc != 0"]
  verdict: PASS
timeout: 60m
checks:
  - clean_tree_after
outside_inputs:
  - ~/models/TinyLlama-1.1B-Chat-v1.0/
cache: inputs_complete
