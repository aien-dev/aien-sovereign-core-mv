# Job definition: capability attenuation, formal oracle bootstrap (ADR 0027, FORMAL-5).
# Plain KEY=VALUE shell assignments, read by formal/formal-job.sh. Paths are relative to the
# aien-architecture checkout (AIEN_ARCH_DIR) except COVERED_PATH, which is a path inside COVERED_REPO.
JOB=formal-cap-attenuation-v1
INVARIANT=formal/invariants/capability-attenuation-v1.toml
ORACLE_DIR=bootstrap/formal-oracles/lean
RUNNER=run-cap-formal.sh
RESULT_PREFIX=CAP_FORMAL_BOOTSTRAP
MODEL="bootstrap/formal-oracles/lean/AienCap/Model.lean"
THEOREM_FILE=bootstrap/formal-oracles/lean/AienCap/Theorems.lean
COVERED_REPO=aien-dev/aienux
COVERED_COMMIT=2ee61b4b158a385c5fcf2c925a625ac043babb21
COVERED_PATH=crates/aienos-aegis/src/capability.rs
