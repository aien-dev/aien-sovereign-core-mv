end

fn crossguest to void
testkey = new uchar 32 0
otherkey = new uchar 32 0
config = new ulong 6 0
fresh testkey otherkey config
for s ulong 16
put testkey 0 uchar add s 100
put config 0 add rem s 2 1
expect gaprovision s testkey config 100 0
end
for s ulong 16
put testkey 0 uchar add s 100
model = add rem s 2 1
expect gaauth testkey 32 model 100 0
check eq get garesult 2 add s 1
expect gaauth testkey 32 sub 3 model 100 403
for i ulong 32
v = get testkey i
put testkey i xor v 128
expect gaauth testkey 32 model 100 401
put testkey i v
end
expect gaadmit testkey 32 model 8 8 100 0
h = get garesult 1
check eq get garesult 2 add s 1
expect gacheck h model 100 0
expect gafinish h 0
expect gacheck h model 100 409
expect int get gacount s 0
expect int get gabudget s 84
end
end

fn main to int
lifecycle
capacity
boundaries
crossguest
if ne get results 1 0
r = write 1 failmsg 0 len failmsg
if lt r 0
ret 2
end
number get results 2
r = write 1 newline 0 len newline
if lt r 0
ret 2
end
ret 1
end
r = write 1 passmsg 0 len passmsg
if lt r 0
ret 2
end
number get results 0
r = write 1 newline 0 len newline
if lt r 0
ret 2
end
ret 0
end
