#!/usr/bin/env bash
# crumb-doctor: the Spark check that crumb failures cannot come back unnoticed (2026-10-19).
#
# The operator may inspect candidate crumbs, but must never build or run a
# candidate-selected gate, hosted tool, Makefile or pin. Main's gate, hosted
# pin and architecture source are the only authority for tool comparisons.
# Candidate changes to that authority need operator promotion, not a verdict
# obtained by executing the PR's own tool. Exit 1 keeps promotion visible in
# the CRUMB-DRIFT alarm until the change lands on trusted main.
#
# --heal moves only a clean trusted clone to origin/main; --heal-only just
# heals it. --alert maintains the CRUMB-DRIFT alert. --no-prs skips PR metadata.
# --repos selects repos. No candidate command is run.
set -u
CLONES=${AIEN_CLONES:-$HOME/workspace/pipeline/clones}
STATE=${AIEN_STATE:-$HOME/.local/state/aien-local-ci}
CACHE=${CRUMB_TOOL_CACHE:-$STATE/crumb-tools}
SANDBOX=${CRUMB_SANDBOX_TOOL:-/usr/local/bin/crumb}
WATCH=${AIEN_WATCH_STATE:-$HOME/.local/state/aienos/watch}
ARCH=$CLONES/aien-architecture
TRUSTED=$CLONES/aien-sovereign-core
REPOS="aien-sovereign-core omega aienos physics aien-protocols aegis-runtime spark-rsi aien-architecture benchmarks synapse interplane"
TOOL_RE='(^|/)crumb\\.lock$|^\\.github/workflows/aien-verification\\.yml$|^tools/crumb/|^tools/aien-local-ci/install\\.sh$|^tests/gates/run\\.sh$'
HEAL=0 HEAL_ONLY=0 ALERT=0 NOPRS=0
while [ $# -gt 0 ]; do
  case $1 in
    --heal) HEAL=1 ;; --heal-only) HEAL=1; HEAL_ONLY=1 ;; --alert) ALERT=1 ;; --no-prs) NOPRS=1 ;;
    --repos) REPOS=${2//,/ }; shift ;;
    *) echo "usage: crumb-doctor [--heal|--heal-only] [--alert] [--no-prs] [--repos a,b]" >&2; exit 2 ;;
  esac; shift
done
npass=0; FAILS=()
record() {  # record STATUS CHECK SUBJECT DETAIL
  printf '%-4s %-6s %-40s %s\n' "$1" "$2" "$3" "$4"
  case $1 in PASS) npass=$((npass+1)) ;; FAIL) FAILS+=("$2 $3") ;; esac
}
g() { git -c advice.detachedHead=false "$@"; }
sha8() { [ -e "$1" ] && sha256sum "$1" | cut -c1-8 || echo -; }

install_tool() {  # install_tool <final> <archived trusted tools/crumb>
  local final=$1 src=$2 tmp
  make -s -C "$src" crumb >&2 || return 1
  mkdir -p "$(dirname "$final")"; tmp=$(mktemp "$(dirname "$final")/.crumb.XXXXXX") || return 1
  cp "$src/crumb" "$tmp" && chmod 0755 "$tmp" && mv -f "$tmp" "$final"
}
build_pin() {  # only an architecture origin/main ancestor may become an operator tool
  local pin=$1 tool=$CACHE/$1/crumb w
  [[ $pin =~ ^[0-9a-f]{40}$ ]] || return 1
  git -C "$ARCH" merge-base --is-ancestor "$pin" refs/remotes/origin/main 2>/dev/null || return 1
  if [ ! -x "$tool" ]; then
    w=$(mktemp -d) || return 1
    if ! git -C "$ARCH" archive "$pin" tools/crumb 2>/dev/null | tar -x -C "$w" \
      || [ ! -f "$w/tools/crumb/Makefile" ] || [ ! -f "$w/tools/crumb/crumb.c" ]; then
      rm -rf "$w"; return 1
    fi
    install_tool "$tool" "$w/tools/crumb"; local rc=$?
    rm -rf "$w"; [ "$rc" = 0 ] || return 1
  fi
  [ -x "$tool" ] && echo "$tool"
}
build_arch_main() { # only architecture's origin/main, never a checked-out candidate
  local main tool w
  main=$(git -C "$ARCH" rev-parse --verify -q 'refs/remotes/origin/main^{commit}') || return 1
  tool=$CACHE/main-$main/crumb
  if [ ! -x "$tool" ]; then
    w=$(mktemp -d) || return 1
    if ! git -C "$ARCH" archive "$main" tools/crumb 2>/dev/null | tar -x -C "$w" \
      || [ ! -f "$w/tools/crumb/Makefile" ] || [ ! -f "$w/tools/crumb/crumb.c" ]; then
      rm -rf "$w"; return 1
    fi
    install_tool "$tool" "$w/tools/crumb"; local rc=$?
    rm -rf "$w"; [ "$rc" = 0 ] || return 1
  fi
  [ -x "$tool" ] && echo "$tool"
}
gate_tool() {  # gate_tool <main tree> <repo>: never pass a PR tree
  local step pin
  step=$(awk '/^[[:space:]]*crumb-verify\)/{on=1} on{print} on&&/;;/{exit}' "$1/tests/gates/run.sh" 2>/dev/null)
  if [[ $step == *crumb.lock* ]]; then
    pin=$(tr -d '[:space:]' < "$1/crumb.lock" | tr 'A-F' 'a-f')
    echo "$(build_pin "$pin")|crumb.lock ${pin:0:8}"
  elif [ "$2" = aien-architecture ] && [[ $step == *tools/crumb/crumb.c* ]]; then
    echo "$(build_arch_main)|architecture origin/main tool"
  elif [[ $step == *'CRUMB:-crumb'* || $step == *'crumb verify'* ]]; then
    echo "$SANDBOX|sandbox $(sha8 "$SANDBOX")"
  else echo "|no crumb-verify step"; fi
}
hosted_tool() { # hosted_tool <main tree> <repo>: never pass a PR tree
  local wf=$1/.github/workflows/aien-verification.yml pin
  [ -f "$wf" ] || { echo "|no hosted workflow"; return; }
  pin=$(grep -A8 'pinned crumb tool source' "$wf" | grep -m1 -oE 'ref:[[:space:]]*[0-9a-f]{40}' | grep -oE '[0-9a-f]{40}')
  if [ -n "$pin" ]; then echo "$(build_pin "$pin")|workflow pin ${pin:0:8}"
  elif grep -q 'pinned crumb tool source' "$wf"; then echo "|workflow pin invalid"
  elif [ "$2" = aien-architecture ] && grep -q 'Build the crumb tool from this repository' "$wf"; then
    echo "$(build_arch_main)|architecture origin/main workflow tool"
  else echo "|workflow has no crumb step"; fi
}
verdict() {  # verdict <trusted tool> <tree>: "OK|<last line>" or "FAIL|<last line>"
  local out rc
  [ -n "$1" ] || { echo "n/a|"; return; }
  out=$(cd "$2" && "$1" verify . 2>&1); rc=$?
  out=$(printf '%s\n' "$out" | tail -1 | sed 's/^crumb verify: //' | cut -c1-70)
  if [ $rc = 0 ] && [[ $out == *OK* ]]; then echo "OK|$out"; else echo "FAIL|$out"; fi
}
# Only main readiness is queried; candidate readiness may still run an older
# installed verifier until the operator installs the repaired worker.
heal_trusted() {
  local head main
  head=$(git -C "$TRUSTED" rev-parse HEAD 2>/dev/null); main=$(git -C "$TRUSTED" rev-parse origin/main 2>/dev/null)
  [ "$HEAL" = 1 ] && [ -n "$main" ] && [ "$head" != "$main" ] || return 0
  if [ -n "$(git -C "$TRUSTED" status --porcelain --untracked-files=no)" ]; then
    record FAIL HEAL "trusted clone" "work tree has local changes; not moved off ${head:0:8}"
  else
    g -C "$TRUSTED" checkout -q --detach origin/main && record INFO HEAL "trusted clone" "work tree moved ${head:0:8} -> origin/main ${main:0:8}"
  fi
}
if [ "$HEAL_ONLY" = 1 ]; then heal_trusted; [ ${#FAILS[@]} = 0 ]; exit $?; fi

SIBFILES=()
if [ "${AIEN_DOCTOR_NO_PROC:-}" != 1 ]; then
  for p in /proc/[0-9]*; do
    cmd=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
    [[ $cmd == *aien-test\ worker* ]] || continue
    [[ $cmd =~ --siblings\ ([^ ]+) ]] && SIBFILES+=("${BASH_REMATCH[1]}|--siblings of pid ${p#/proc/}")
  done
fi

echo "crumb-doctor $(date -u +%FT%TZ): sandbox $SANDBOX $(sha8 "$SANDBOX"); tools from origin/main only"

# SIBMAP
map_rows() { sed 's/#.*//' "$@" 2>/dev/null | awk 'NF==4 {print $1" "$2}' | sort -u; }
heal_trusted
main=$(git -C "$TRUSTED" rev-parse origin/main 2>/dev/null)
want=$(git -C "$TRUSTED" show origin/main:tools/aien-local-ci/siblings 2>/dev/null | sed 's/#.*//' | awk 'NF==4 {print $1" "$2}' | sort -u)
for entry in "$TRUSTED/tools/aien-local-ci/siblings|default (poll workers)" "${SIBFILES[@]}"; do
  f=${entry%%|*}; who=${entry#*|}
  missing=$(comm -23 <(printf '%s\n' "$want") <(map_rows "$f") | grep . | sed 's/ / ..\//' | paste -sd, -)
  if [ -n "$missing" ]; then record FAIL SIBMAP "$f" "$who: missing $missing (origin/main ${main:0:8} has them)"
  else record PASS SIBMAP "$f" "$who: matches origin/main ${main:0:8}"; fi
done
for repo in $REPOS; do
  runsh=$(git -C "$CLONES/$repo" show origin/main:tests/gates/run.sh 2>/dev/null)
  need=$( { printf '%s\n' "$runsh" | grep -oE 'need_sibling[[:blank:]]+[A-Za-z0-9._-]+' | awk '{print $2}'
            printf '%s\n' "$runsh" | grep -E '^[[:blank:]]*pin[[:blank:]]+[^[:blank:]]+[[:blank:]]+[^[:blank:]]+[[:blank:]]+[^[:blank:]]+' | awk '{print $3}'; } | sort -u)
  for d in $need; do
    grep -qx "$repo $d" <<<"$want" || record FAIL SIBMAP "$repo needs ../$d" "origin/main sibling map has no line for it"
  done
done

# AGREE compares the trusted-main gate, hosted and readiness verdicts. For a
# PR only the trusted-main tool may inspect its crumbs; candidate metadata
# changes are reported as pending promotion, not treated as executable tools.
ready_check() { # ready_check <repo> <sha> <label> <main tree> <tool> <description>
  [ "${AIEN_DOCTOR_NO_READY:-}" = 1 ] && return
  command -v aien-local-ci >/dev/null || return
  local want report got actual expected pin
  want=$(verdict "$5" "$4"); [ "${want%%|*}" = OK ] && want=CURRENT || want=STALE
  case $6 in
    crumb.lock\ *) pin=$(tr -d '[:space:]' < "$4/crumb.lock" | tr 'A-F' 'a-f'); expected="trusted-base $pin" ;;
    architecture\ origin/main\ tool) expected="trusted-base $(git -C "$ARCH" rev-parse origin/main)" ;;
    sandbox\ *) expected="$SANDBOX (operator command; no lock at BASE)" ;;
    *) record FAIL READY "$1 $3" "unknown trusted main tool $6"; return ;;
  esac
  report=$(aien-local-ci verify "$1" "$2" 2>/dev/null)
  got=$(printf '%s\n' "$report" | sed -n 's/^Crumb status: //p' | head -1)
  actual=$(printf '%s\n' "$report" | sed -n 's/^Crumb tool: //p' | head -1)
  if [ "$got" = "$want" ] && [ "$actual" = "$expected" ]; then
    record PASS READY "$1 $3" "aien-test verify Crumb status $got (trusted $actual)"
  else
    record FAIL READY "$1 $3" "verify status ${got:-none} tool ${actual:-none}; trusted status $want tool $expected"
  fi
}
check_main() { # check_main <repo>
  local repo=$1 clone=$CLONES/$1 w sha tree gt ht gv hv label
  w=$(mktemp -d); sha=$(git -C "$clone" rev-parse --verify -q 'refs/remotes/origin/main^{commit}')
  label="main ${sha:0:8}"
  if [ -z "$sha" ] || ! git clone -q --shared --no-checkout "$clone" "$w/t" || ! g -C "$w/t" checkout -q --detach "$sha"; then
    record FAIL AGREE "$repo $label" "cannot check out origin/main"; rm -rf "$w"; return
  fi
  tree=$w/t
  if [ ! -e "$tree/.crumb" ]; then record PASS AGREE "$repo $label" "no crumbs"; rm -rf "$w"; return; fi
  gt=$(gate_tool "$tree" "$repo"); ht=$(hosted_tool "$tree" "$repo")
  if [ -z "${gt%%|*}" ]; then
    record FAIL AGREE "$repo $label" "trusted gate tool unavailable (${gt#*|})"; rm -rf "$w"; return
  fi
  ready_check "$repo" "$sha" "$label" "$tree" "${gt%%|*}" "${gt#*|}"
  gv=$(verdict "${gt%%|*}" "$tree"); hv=$(verdict "${ht%%|*}" "$tree")
  if [ -z "${ht%%|*}" ] && [[ ${ht#*|} == workflow\ pin* || ${ht#*|} == architecture\ origin/main\ workflow* ]]; then
    record FAIL AGREE "$repo $label" "trusted hosted tool unavailable (${ht#*|})"
  elif [ "${hv%%|*}" = n/a ] || [ "${gv%%|*}" = "${hv%%|*}" ]; then
    record PASS AGREE "$repo $label" "trusted gate[${gt#*|}]=${gv%%|*}; hosted[${ht#*|}]=${hv%%|*}"
  else
    record FAIL AGREE "$repo $label" "trusted gate[${gt#*|}]=${gv%%|*}; hosted[${ht#*|}]=${hv%%|*}"
  fi
  rm -rf "$w"
}
check_candidate() { # check_candidate <repo> <sha> <pr number>: inspect metadata only
  local repo=$1 sha=$2 n=$3 clone=$CLONES/$1 changes
  git -C "$clone" cat-file -e "$sha^{commit}" 2>/dev/null || git -C "$clone" fetch -q origin "pull/$n/head" 2>/dev/null
  if ! git -C "$clone" cat-file -e "$sha^{commit}" 2>/dev/null; then
    record FAIL PROMOTE "$repo #$n" "cannot inspect candidate $sha"; return
  fi
  changes=$(git -C "$clone" diff --name-only origin/main "$sha" -- crumb.lock tools/crumb \
    .github/workflows/aien-verification.yml tools/aien-local-ci/install.sh tests/gates/run.sh)
  if [ -n "$changes" ]; then
    record FAIL PROMOTE "$repo #$n" "operator promotion required for candidate tool/pin changes: $(printf '%s\n' "$changes" | paste -sd, -); no candidate tools executed"
  else
    record INFO PROMOTE "$repo #$n" "candidate metadata unchanged; no candidate tool verdict or execution"
  fi
}
for repo in $REPOS; do
  clone=$CLONES/$repo; [ -d "$clone/.git" ] || { record FAIL AGREE "$repo" "no trusted clone at $clone"; continue; }
  git -C "$clone" fetch -q origin 2>/dev/null
  check_main "$repo"
  [ "$NOPRS" = 1 ] && continue
  slug=$(git -C "$clone" remote get-url origin | sed -E 's#.*github\.com[:/]##; s#\.git$##')
  prs=$(gh pr list -R "$slug" --state open --limit 100 --json number,headRefOid,title,files \
        --jq ".[] | select((.title|test(\"RFC-0003\")) or ([.files[]?.path] | any(test(\"$TOOL_RE\")))) | \"\(.number) \(.headRefOid)\"" 2>/dev/null) \
    || { record FAIL AGREE "$repo PR list" "gh pr list failed"; continue; }
  while read -r n sha; do
    [ -n "$n" ] || continue
    check_candidate "$repo" "$sha" "$n"
  done <<<"$prs"
done

echo "crumb-doctor: $npass pass, ${#FAILS[@]} FAIL"
if [ "$ALERT" = 1 ]; then
  mkdir -p "$WATCH"; stamp=$(date -u +%FT%TZ)
  keep=$(grep -v '^CRUMB-DRIFT:' "$WATCH/ALERT" 2>/dev/null)
  if [ ${#FAILS[@]} -gt 0 ]; then
    text=$(printf '%s; ' "${FAILS[@]}" | cut -c1-600)
    printf '%s CRUMB-DRIFT %s\n' "$stamp" "$text" >> "$WATCH/alerts.log"
    keep=$(printf '%s\n%s' "$keep" "CRUMB-DRIFT: ${#FAILS[@]} crumb check(s) fail: $text(run: crumb-doctor; since $stamp)" | grep .)
  fi
  if [ -n "$keep" ]; then printf '%s\n' "$keep" > "$WATCH/ALERT.tmp" && mv -f "$WATCH/ALERT.tmp" "$WATCH/ALERT"; else rm -f "$WATCH/ALERT"; fi
fi
[ ${#FAILS[@]} = 0 ]
