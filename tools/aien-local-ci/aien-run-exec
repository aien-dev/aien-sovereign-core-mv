#!/bin/bash
# aien-run-exec: the C8 exec contract of the sovereign local pipeline (lane INFRA).
#
#   aien-run-exec --cwd DIR --timeout SECS --profile host|qemu|gb10 [--env K=V]... -- PROGRAM [ARGS...]
#
# Runs PROGRAM as the unprivileged system user `aien-run` with:
#   * a cleared environment: only PATH, HOME, CARGO_HOME, RUSTUP_HOME and the explicit --env pairs survive;
#   * a private mount namespace in which the whole sandbox home /var/lib/aien-run is READ-ONLY except
#     (a) the one worktree that contains --cwd and (b) the one target dir named by --env CARGO_TARGET_DIR.
#     So a check can never plant files that a later check (another PR, or a `main` qualification) would
#     pick up: no ~/.cargo/config.toml, no swapped registry or cargo binary, no edits to another worktree,
#     no writes into the other trust class's target dir;
#   * private, empty /var/tmp, /var/crash, /var/lib/BrlAPI for every profile, and private /tmp, /dev/shm, /run/lock,
#     /run/screen plus a fresh IPC namespace (SysV shm, semaphores, POSIX queues) for host|qemu (gb10 keeps the
#     host /tmp, /dev/shm and IPC so chip tooling behaves as before);
#   * a fresh network namespace for host|qemu: only its own loopback `lo`, brought up so tests can talk to a
#     server they start on 127.0.0.1 (the namespace has no other interface, so nothing outside it is reachable,
#     not even the host's own 127.0.0.1 services; no DNS);
#   * a transient systemd scope under aien-run.slice with cgroup caps (memory, pids, cpu) and a
#     device policy (host|qemu: standard pseudo devices only, qemu adds /dev/kvm; gb10: all devices);
#   * the operator's model directory (~/models of the sudo caller) mounted READ-ONLY at /var/lib/aien-run/models
#     when both exist (install.sh makes the empty root-owned mount point), so model gates such as PREFILL-E2E-2
#     find their checkpoint at $HOME/models without any write access to it; without it the gate reports
#     NOT_RUN model_missing;
#   * rlimits (no core dumps, bounded open files);
#   * `timeout --signal=TERM --kill-after=10 SECS` for host|qemu (exit 124 on expiry);
#   * NO timeout for gb10: chip runs are never killed; the engine's advisory timeout only marks the receipt.
# stdout/stderr pass through. The exit code of PROGRAM passes through (124 = timeout, 137 = killed).
# Exit 2 = refused by this script (bad arguments or unsafe host layout); PROGRAM did not run.
# When the command finishes the whole scope is stopped, so a crashed check leaves no stray processes.
#
# Argument rules (all checked before anything runs):
#   --cwd     absolute, existing and canonical (no symlinks, no trailing slash). Inside /var/lib/aien-run it
#             must be /var/lib/aien-run itself or inside wt/<repo>/<40-hex sha>; that worktree is the only
#             writable one.
#   --env     K=V with a plain name; PATH, HOME, CARGO_HOME, RUSTUP_HOME, LD_*, BASH_ENV, ENV refused;
#             each name at most once. CARGO_TARGET_DIR, if given, must be exactly
#             /var/lib/aien-run/target/<repo>/pr/<sha40> or .../main/<sha40>: the head's own dir inside its
#             trust class (A2), created if missing. With --cwd in a worktree, <repo> and <sha40> must be that
#             worktree's. One dir per head: a shared dir let cargo link one head's build into another (sc #605).
#   PROGRAM   may not contain '=' or start with '-' (so it can never be read as an extra environment
#             assignment by `env`). A bare name resolves only through the sandbox PATH
#             /var/lib/aien-run/cargo/bin:/usr/local/bin:/usr/bin:/bin (all root-owned, checked at start);
#             a file of the same name inside the worktree is never picked up.
#
# Optional extensions (not required by C8, used by tests and the engine):
#   --memory-max BYTES|NUM[KMG]   override the per-profile MemoryMax (tests use a small cap)
#   --tasks-max N                 override TasksMax
#   --cpu-quota PCT               override CPUQuota (percent, 100 = one core)
#
# Installed root-owned 0755 at /usr/local/sbin/aien-run-exec by tools/aien-local-ci/install.sh.
# Invoked by the trusted side as: sudo -n /usr/local/sbin/aien-run-exec ... (see /etc/sudoers.d/aien-local-ci).
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

RUN_USER=aien-run
RUN_HOME=/var/lib/aien-run
RUN_PATH=/var/lib/aien-run/cargo/bin:/usr/local/bin:/usr/bin:/bin
SLICE=aien-run.slice
KILL_AFTER=10
NAME_RE='^[A-Za-z0-9._-]+$'

die() { printf 'aien-run-exec: %s\n' "$*" >&2; exit 2; }
usage() {
  printf 'usage: aien-run-exec --cwd DIR --timeout SECS --profile host|qemu|gb10 [--env K=V]... -- PROGRAM [ARGS...]\n' >&2
  exit 2
}
plain_name() { [[ $1 =~ $NAME_RE && $1 != . && $1 != .. ]]; }

[[ $(id -u) -eq 0 ]] || die "must run as root (via sudo -n)"

cwd=""; secs=""; profile=""; envs=(); mem_max=""; tasks_max=""; cpu_quota=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd)        [[ $# -ge 2 ]] || usage; cwd=$2; shift 2 ;;
    --timeout)    [[ $# -ge 2 ]] || usage; secs=$2; shift 2 ;;
    --profile)    [[ $# -ge 2 ]] || usage; profile=$2; shift 2 ;;
    --env)        [[ $# -ge 2 ]] || usage; envs+=("$2"); shift 2 ;;
    --memory-max) [[ $# -ge 2 ]] || usage; mem_max=$2; shift 2 ;;
    --tasks-max)  [[ $# -ge 2 ]] || usage; tasks_max=$2; shift 2 ;;
    --cpu-quota)  [[ $# -ge 2 ]] || usage; cpu_quota=$2; shift 2 ;;
    --)           shift; break ;;
    -h|--help)    usage ;;
    *)            die "unknown argument: $1" ;;
  esac
done
[[ $# -ge 1 ]] || usage
[[ -n $cwd && -n $secs && -n $profile ]] || usage
[[ $secs =~ ^[0-9]+$ && $secs -gt 0 ]] || die "--timeout must be a positive integer of seconds: $secs"
case "$profile" in host|qemu|gb10) ;; *) die "--profile must be host|qemu|gb10: $profile" ;; esac
[[ -z $mem_max  || $mem_max  =~ ^[0-9]+[KMGT]?$ ]] || die "--memory-max must be NUM[KMGT]: $mem_max"
[[ -z $tasks_max || $tasks_max =~ ^[0-9]+$ ]] || die "--tasks-max must be an integer: $tasks_max"
[[ -z $cpu_quota || $cpu_quota =~ ^[0-9]+$ ]] || die "--cpu-quota must be an integer percent: $cpu_quota"
[[ -n $1 && $1 != *=* && $1 != -* ]] || die "PROGRAM may not be empty, contain '=' or start with '-': $1"

# --cwd: canonical, and inside the sandbox home only the home itself or a worktree.
[[ $cwd == /* && -d $cwd ]] || die "--cwd must be an existing absolute directory: $cwd"
[[ $(realpath -e -- "$cwd") == "$cwd" ]] || die "--cwd must be canonical (no symlinks, no trailing slash): $cwd"
wtroot=""; repo=""; sha=""
case "$cwd" in
  "$RUN_HOME") ;;
  "$RUN_HOME"/wt/*/*)
    rel=${cwd#"$RUN_HOME"/wt/}; repo=${rel%%/*}; rest=${rel#*/}; sha=${rest%%/*}
    plain_name "$repo" && [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "--cwd must be inside $RUN_HOME/wt/<repo>/<40-hex sha>: $cwd"
    wtroot=$RUN_HOME/wt/$repo/$sha ;;
  "$RUN_HOME"/*) die "--cwd inside $RUN_HOME must be the home itself or inside wt/<repo>/<sha>: $cwd" ;;
esac

# --env: plain names, refused names, no duplicates, CARGO_TARGET_DIR only as target/<repo>/pr|main/<sha40>
# (the worktree's own repo and sha when --cwd is in one).
tdir=""; seen=" "
for kv in "${envs[@]}"; do
  [[ $kv =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "--env needs K=V with a valid name: $kv"
  k=${kv%%=*}
  case "$k" in
    LD_*|BASH_ENV|ENV|HOME|CARGO_HOME|RUSTUP_HOME|PATH) die "--env may not set $k" ;;
  esac
  [[ $seen != *" $k "* ]] || die "--env sets $k twice"
  seen+="$k "
  if [[ $k == CARGO_TARGET_DIR ]]; then
    tdir=${kv#*=}
    trel=${tdir#"$RUN_HOME"/target/}; IFS=/ read -r trepo tclass tsha textra <<<"$trel"
    [[ $tdir == "$RUN_HOME/target/$trepo/$tclass/$tsha" && -z $textra && ( $tclass == pr || $tclass == main ) \
       && $tsha =~ ^[0-9a-f]{40}$ ]] && plain_name "$trepo" \
      || die "CARGO_TARGET_DIR must be $RUN_HOME/target/<repo>/pr/<sha40> or .../main/<sha40>: $tdir"
    [[ -z $sha || ( $trepo == "$repo" && $tsha == "$sha" ) ]] \
      || die "CARGO_TARGET_DIR must be this worktree's own ($repo $sha): $tdir"
  fi
done
getent passwd "$RUN_USER" >/dev/null || die "user $RUN_USER does not exist (run tools/aien-local-ci/install.sh)"

# Host layout self-check: everything the sandbox could use to influence a later run must be root-owned and not
# writable by group/other (the mount namespace below is the main guard; this catches a broken install).
for p in "$RUN_HOME" "$RUN_HOME/cargo" "$RUN_HOME/cargo/bin" "$RUN_HOME/rustup" "$RUN_HOME/target" /usr/local/bin /usr/bin; do
  read -r u m < <(stat -L -c '%u %a' "$p" 2>/dev/null || echo "x x")
  [[ $u == 0 ]] || die "unsafe host layout: $p is not root-owned (re-run tools/aien-local-ci/install.sh)"
  (( (8#$m & 8#022) == 0 )) || die "unsafe host layout: $p is group/other-writable ($m)"
done

# The head's target dir: created on demand (missing parents root-owned, the head's dir aien-run). Only that one
# dir is mounted writable below, so a run can never touch another head's build or the other trust class.
if [[ -n $tdir ]]; then
  if [[ ! -d $tdir ]]; then
    [[ -d ${tdir%/*} ]] || install -d -o root -g root -m 0755 "${tdir%/*}"
    install -d -o "$RUN_USER" -g "$RUN_USER" -m 0755 "$tdir"
  fi
  [[ $(realpath -e -- "$tdir") == "$tdir" ]] || die "CARGO_TARGET_DIR must be canonical: $tdir"
fi

# Per-profile caps. Machine: 20 cores, 121 GB RAM. host/qemu leave headroom for the trusted side;
# gb10 may use most of the unified memory but still cannot take the whole machine.
case "$profile" in
  host) : "${mem_max:=48G}"; : "${tasks_max:=4096}"; : "${cpu_quota:=1600}" ;;
  qemu) : "${mem_max:=48G}"; : "${tasks_max:=4096}"; : "${cpu_quota:=1600}" ;;
  gb10) : "${mem_max:=96G}"; : "${tasks_max:=4096}"; : "${cpu_quota:=1800}" ;;
esac

unit="aien-run-exec-$$-$(date +%s%N | tail -c 7)"
props=(-p "MemoryMax=$mem_max" -p "MemorySwapMax=0" -p "TasksMax=$tasks_max" -p "CPUQuota=${cpu_quota}%")
case "$profile" in
  host) props+=(-p DevicePolicy=closed) ;;
  qemu) props+=(-p DevicePolicy=closed -p "DeviceAllow=/dev/kvm rw") ;;
  gb10) props+=(-p DevicePolicy=auto) ;;
esac

# Mount setup, run as root inside the new mount namespace. Parameters are positional, never interpolated.
# Order matters: the writable pieces are bound onto themselves first, then the home is bound recursively onto
# itself and only that top mount is made read-only, so the self-binds underneath stay writable.
# shellcheck disable=SC2016
NS_SETUP='
set -euo pipefail
home=$1 profile=$2 wtroot=$3 tdir=$4 models=$5; shift 5
for p in "$wtroot" "$tdir"; do [[ -z $p ]] || mount --bind "$p" "$p"; done
mount --rbind "$home" "$home"
mount -o remount,bind,ro "$home"
if [[ -n $models ]]; then mount --bind "$models" "$home/models"; mount -o remount,bind,ro "$home/models"; fi
priv=(/var/tmp /var/crash /var/lib/BrlAPI)
case $profile in host|qemu) priv+=(/tmp /dev/shm /run/lock /run/screen) ;; esac
for d in "${priv[@]}"; do
  if [[ -d $d ]]; then mount -t tmpfs -o mode=1777,nosuid,nodev aien-run-tmp "$d"; fi
done
case $profile in host|qemu) mount -t mqueue -o nosuid,nodev,noexec aien-run-mqueue /dev/mqueue ;; esac
# host|qemu run in their own network namespace (unshare -n above): raise its loopback, nothing else exists in it.
case $profile in host|qemu) ip link set lo up ;; esac
exec "$@"
'

# Model directory of the operator who called sudo, if any (read-only bind, see the header).
models_src=""
if [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
  op_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
  if [[ -n $op_home && -d $op_home/models && -d $RUN_HOME/models ]]; then models_src=$(realpath -e -- "$op_home/models"); fi
fi

inner=()
case "$profile" in
  host|qemu) inner+=(unshare -m -n -i --propagation private --) ;;
  gb10)      inner+=(unshare -m --propagation private --) ;;
esac
inner+=(bash -c "$NS_SETUP" aien-run-ns "$RUN_HOME" "$profile" "$wtroot" "$tdir" "$models_src")
inner+=(prlimit --core=0 --nofile=65536 --)
case "$profile" in
  host|qemu) inner+=(timeout --signal=TERM --kill-after="$KILL_AFTER" "$secs") ;;
esac
inner+=(setpriv --reuid "$RUN_USER" --regid "$RUN_USER" --init-groups --reset-env --no-new-privs --)
inner+=(env -i -C "$cwd" "PATH=$RUN_PATH" "HOME=$RUN_HOME" "CARGO_HOME=$RUN_HOME/cargo" "RUSTUP_HOME=$RUN_HOME/rustup")
for kv in "${envs[@]}"; do inner+=("$kv"); done

cleanup() { systemctl kill --signal=KILL "$unit.scope" >/dev/null 2>&1 || true; systemctl stop "$unit.scope" >/dev/null 2>&1 || true; }
trap 'cleanup; exit 143' TERM INT HUP

rc=0
cd /
systemd-run --scope --quiet --collect --unit "$unit" --slice "$SLICE" "${props[@]}" -- "${inner[@]}" "$@" || rc=$?
cleanup
exit "$rc"
