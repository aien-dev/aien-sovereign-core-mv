def log(msg):
    line = "%s %s %s" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), NAME, msg)
    print(line, flush=True)
    if LOGF:
        with open(LOGF, "a") as f:
            f.write(line + "\n")


def run(cmd, cwd=None, timeout=300):
    try:
        p = subprocess.run(cmd, shell=isinstance(cmd, str), cwd=cwd, env=ENV, capture_output=True, text=True, timeout=timeout)
        err = p.stderr or ""
        return p.returncode, (p.stdout or ""), err
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except OSError as exc:
        return 127, "", str(exc)


def gh_json(args, timeout=120):
    rc, out, err = run(["gh"] + args, timeout=timeout)
    if rc != 0:
        raise RuntimeError(err.strip()[-300:] or out[-300:])
    if not out.strip():
        raise RuntimeError("GitHub returned an empty JSON response")
    value = json.loads(out)
    if value is None:
        raise RuntimeError("GitHub returned a null JSON response")
    return value


def lane_owned(repo):
    try:
        for line in open(LANES):
            parts = line.split()
            if len(parts) >= 3 and parts[0] == "lane" and parts[1] == repo:
                return "renda" in line.lower()
    except OSError:
        pass
    return False


def held(repo, pr):
