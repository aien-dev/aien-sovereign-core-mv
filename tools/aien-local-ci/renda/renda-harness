def model_id():
    try:
        with urllib.request.urlopen(ENDPOINT + "/models", timeout=5) as r:
            return json.load(r)["data"][0]["id"]
    except Exception:
        return None


def ask_model(prompt, max_tokens=200):
    mid = model_id()
    if not mid:
        return None, "model server down"
    body = json.dumps({"model": mid, "messages": [{"role": "user", "content": prompt}],
                       "max_tokens": max_tokens, "temperature": 0}).encode()
    for _ in range(60):  # one generation at a time on the server: wait our turn on 503
        try:
            req = urllib.request.Request(ENDPOINT + "/chat/completions", data=body, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=600) as r:
                d = json.load(r)
            return d["choices"][0]["message"]["content"], mid
        except urllib.error.HTTPError as e:
            if e.code == 503:
                time.sleep(3)
                continue
            return None, "http %d" % e.code
        except Exception as e:
            return None, str(e)[:200]
    return None, "server busy for 3 minutes"


def spark_status(full, sha):
    try:
        st = gh_json(["api", f"repos/{full}/commits/{sha}/statuses?per_page=100"])
    except Exception:
        return "none", ""
    for s in st or []:  # newest first
        if s.get("context") == SPARK:
            return s.get("state", "none"), s.get("description") or ""
    return "none", ""


def judging(sha):
    rc, out, _ = run("pgrep -af 'worker --once|aien-local-ci once|aien-local-ci trigger' || true")
    return sha[:12] in out or sha in out


def review(full, pr, title):
    rc, diff, err = run(["gh", "pr", "diff", str(pr), "-R", full], timeout=180)
    if rc != 0:
        return False, "cannot read diff: " + err[-200:]
    files = re.findall(r"^diff --git a/(\S+)", diff, re.M)
    body = diff if len(diff) < 60000 else diff[:60000] + "\n[diff truncated at 60000 chars of %d]" % len(diff)
    prompt = ("You review a pull request for the aien-dev project before it is merged. Its tests already passed on "
              "the project's own judge. Refuse ONLY for a concrete problem you can point to in the diff: a secret or "
              "key, a private path or personal data, debug junk left in, files clearly unrelated to the title, or a "
              "change that deletes large working parts without saying why. Otherwise approve.\n"
              f"Repository: {full}\nPR #{pr}: {title}\nFiles ({len(files)}): {', '.join(files[:60])}\n\n{body}\n\n"
              'Reply with one JSON object only: {"merge": true or false, "note": "<one line: what the diff does, '
              'or the concrete problem>"}')
    text, mid = ask_model(prompt)
    if text is None:
        return None, mid
    m = re.search(r"\{.*\}", text, re.S)
    try:
        d = json.loads(m.group(0))
    except Exception:
        return None, "unparsable review: " + text[:200]
    return bool(d.get("merge")), (str(d.get("note") or "")[:300] + f" [review by {mid}]")


def guarded_git_source(repo, full, pinned):
    """The existing crumb helper supports GIT injection. Recheck only at its final push."""
    return ("#!/usr/bin/env python3\nimport importlib.util, importlib.machinery, os, sys\n"
            f"p = {SOURCE_FILE!r}\n"
            "s = importlib.util.spec_from_file_location('renda_push_guard', p, loader=importlib.machinery.SourceFileLoader('renda_push_guard', p))\n"
            "m = importlib.util.module_from_spec(s); s.loader.exec_module(m)\n"
            "if len(sys.argv) > 1 and sys.argv[1] == 'push':\n"
            f"    ok, note = m.remote_admitted({repo!r}, {full!r}, {pinned!r})\n"
            "    if not ok:\n        print('Renda push held: ' + note, file=sys.stderr); sys.exit(98)\n"
            "os.execvp('git', ['git'] + sys.argv[1:])\n")


def rebase(repo, full, pr, branch, sha):
    """Rebase branch onto main in our own clone; crumb-only conflicts via rebase-crumb.sh. Returns (ok, note)."""
    os.makedirs(WORK, exist_ok=True)
    wt = f"{WORK}/{repo}"
    if not os.path.isdir(f"{wt}/.git"):
        ref = f"{CLONES}/{repo}"
        rc, _, err = run(["git", "clone", "-q"] + (["--reference-if-able", ref] if os.path.isdir(ref) else [])
                         + [f"https://github.com/{full}.git", wt], timeout=900)
        if rc != 0:
            return False, "clone failed: " + err[-200:]
        run(["git", "config", "user.name", "Renda (aien-dev desk bot)"], cwd=wt)
        run(["git", "config", "user.email", "drake@aienos.com"], cwd=wt)
    run("git rebase --abort; git merge --abort; git reset -q --hard; git clean -qfdx", cwd=wt)
    run(["git", "fetch", "-q", "origin", "main", branch], cwd=wt, timeout=600)
    rc, cur, _ = run(["git", "rev-parse", f"origin/{branch}"], cwd=wt)
    if cur.strip() != sha:
        return False, f"head moved ({cur.strip()[:8]} != {sha[:8]}), next pass"
    script = None
    for cand in (f"{CLONES}/aien-architecture/scripts/rebase-crumb.sh",):
        if os.path.exists(cand):
            script = cand
    if script:
        from local_queue import decode_one, graphql_args
        try:
            pinned = decode_one(gh_json(graphql_args(full, number=pr)))
        except Exception as exc:
            return False, 'rebase source unreadable: ' + str(exc)[-200:]
        if pinned['headRefOid'] != sha:
            return False, 'head moved before scripted rebase'
        with tempfile.TemporaryDirectory(prefix='renda-rebase-', dir=STATE) as tmp:
            wrapper = os.path.join(tmp, 'git-checked')
            with open(wrapper, 'w') as f:
                f.write(guarded_git_source(repo, full, pinned))
            os.chmod(wrapper, 0o755)
            rc, out, err = run(['env', 'GIT=' + wrapper, 'bash', script, wt, branch], cwd=wt, timeout=1800)
        if rc == 0:
            rc2, new, _ = run(["git", "rev-parse", "HEAD"], cwd=wt)
            return True, f"rebased onto main, new head {new.strip()[:8]} (rebase-crumb.sh)"
        if rc == 3:
            files = re.findall(r"^\s*(?:UU|AA|DU|UD)\s+(\S+)", out + err, re.M)
            return False, "code conflict with main" + (": " + ", ".join(files[:8]) if files else "") + " (owner must rebase)"
        return False, f"rebase-crumb.sh exit {rc}: " + (err or out).strip()[-200:]
    # no script: plain rebase, push only if it applies cleanly
    run(["git", "checkout", "-q", "-B", branch, f"origin/{branch}"], cwd=wt)
    rc, out, err = run(["git", "rebase", "-q", "origin/main"], cwd=wt, timeout=900)
    if rc != 0:
        run("git rebase --abort", cwd=wt)
        return False, "conflict with main (owner must rebase)"
    from local_queue import decode_one, graphql_args
    pinned = decode_one(gh_json(graphql_args(full, number=pr)))
    if not valid_pr(pinned) or pinned['headRefOid'] != sha:
        return False, 'head moved or unavailable before push'
    admitted, reason = remote_admitted(repo, full, pinned)
    if not admitted:
        return False, reason
    rc, out, err = run(["git", "push", "-q", f"--force-with-lease={branch}:{sha}", "origin", f"HEAD:{branch}"], cwd=wt, timeout=600)
    return (rc == 0), ("rebased and pushed" if rc == 0 else "push failed: " + err[-200:])


def hosted_rerun(full, sha, repo):
    rc, out, _ = run(["gh", "api", f"repos/aien-dev/aien-receipts/contents/{repo}/{sha}", "--jq", "length"])
    if rc != 0:
        return False, "bundle not in aien-receipts yet"
    try:
        runs = gh_json(["api", f"repos/{full}/actions/runs?head_sha={sha}&per_page=50"])["workflow_runs"]
    except Exception as e:
        return False, "cannot list runs: %s" % e
    for r in runs:
        if r.get("name") == HOSTED and r.get("conclusion") not in ("success", None):
            rc, _, err = run(["gh", "run", "rerun", str(r["id"]), "-R", full, "--failed"])
            return rc == 0, ("hosted check rerun started" if rc == 0 else "rerun failed: " + err[-150:])
    return False, "no failed hosted run to rerun"


def operator_verdict(repo, sha):
    """L319: the verdict an operator run already left on this exact head, or None.
    A bundle whose reason is PIPELINE_CONFIG_CHANGED is the worker's refusal that asks for the operator run,
    so it is not a verdict. A NOT_RUN caused by the gpu lock judged nothing and may be run again."""
    try:
        b = json.load(open(f"{STATE}/bundles/{repo}/{sha}/bundle.json"))
    except (OSError, ValueError):
        return None
    verdict = b.get("verdict")
    plan = b.get("plan") or {}
    reason = plan.get("reason") or ""
    if not verdict or reason == "PIPELINE_CONFIG_CHANGED":
        return None
    if verdict == "NOT_RUN" and reason.endswith(":gpu_lock"):
        return None
    return verdict, reason


def operator_run(repo, sha):
    """Never retry a verdict (Drake: a failing gate means the work is wrong). Say it once per head, leave it to the owner."""
    v = operator_verdict(repo, sha)
    if v:
        what = f"{v[0]} {v[1]}".strip()
        seen = f"{STATE}/renda-operator-reported-{repo}"
        try:
            known = open(seen).read().split()
        except OSError:
            known = []
        if sha not in known:
            with open(seen, "a") as f:
                f.write(sha + "\n")
            return True, f"operator verdict on this head: {what} (not run again; the PR owner fixes the head or pushes a new one)"
        return False, f"operator verdict on this head: {what} (not run again)"
    if judging(sha):
        return False, "judge already running on this head"
    rc, out, _ = run("pgrep -af 'aien-local-ci once' || true")
    if f" {repo} " in out:
        return False, "an operator run for this repo is already going"
    logp = f"{LOGDIR}/operator-{repo}-{sha[:8]}.log"
    if os.environ.get("RENDA_OPERATOR_DRY"):
        return True, f"operator judge run started (dry run, log {logp})"
    subprocess.Popen(f"setsid nohup aien-local-ci once {repo} {sha} --operator > {logp} 2>&1 < /dev/null &",
                     shell=True, env=ENV)
    return True, f"operator judge run started (log {logp})"


