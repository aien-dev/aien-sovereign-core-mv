def clone_for(repo, full):
    os.makedirs(WORK, exist_ok=True)
    wt = f"{WORK}/{repo}"
    if not os.path.isdir(f"{wt}/.git"):
        ref = f"{CLONES}/{repo}"
        rc, _, err = run(["git", "clone", "-q"] + (["--reference-if-able", ref] if os.path.isdir(ref) else [])
                         + [f"https://github.com/{full}.git", wt], timeout=900)
        if rc != 0:
            raise RuntimeError("clone failed: " + err[-200:])
        run(["git", "config", "user.name", "Renda (aien-dev desk bot)"], cwd=wt)
        run(["git", "config", "user.email", "drake@aienos.com"], cwd=wt)
    run("git rebase --abort; git merge --abort; git reset -q --hard; git clean -qfdx", cwd=wt)
    return wt


def build_block(repo, full, cands, res):
    """One integration branch carrying many PRs, judged once (Drake: 'do this in blocks')."""
    for candidate in cands:
        admitted, reason = remote_admitted(repo, full, candidate)
        if not admitted:
            raise RuntimeError('block source admission refused: ' + reason)
    wt = clone_for(repo, full)
    branches = [p["headRefName"] for p in cands]
    run(["git", "fetch", "-q", "origin", "main"] + branches, cwd=wt, timeout=900)
    ts = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    b = f"desk/block-{repo}-{ts}"
    run(["git", "checkout", "-q", "-B", b, "origin/main"], cwd=wt)
    carried, skipped = [], []
    for p in cands:
        rc, cur, _ = run(["git", "rev-parse", f"origin/{p['headRefName']}"], cwd=wt)
        if cur.strip() != p["headRefOid"]:
            skipped.append((p, "head moved"))
            continue
        rc, out, err = run(["git", "merge", "-q", "--no-ff", "--no-edit", "-m",
                            f"block: carry #{p['number']} {p['title'][:60]}", p["headRefOid"]], cwd=wt, timeout=600)
        if rc != 0:
            _, um, _ = run(["git", "diff", "--name-only", "--diff-filter=U"], cwd=wt)
            um = [f for f in um.split() if f]
            if um and all(f.endswith(".crumb") or os.path.basename(f) in ("crumb.lock",) for f in um):
                run(["git", "checkout", "--ours", "--"] + um, cwd=wt)
                run(["git", "add", "--"] + um, cwd=wt)
                rc2, _, _ = run(["git", "-c", "core.editor=true", "commit", "-q", "--no-edit"], cwd=wt)
                if rc2 == 0:
                    carried.append(p)
                    continue
            run("git merge --abort", cwd=wt)
            skipped.append((p, "conflicts with main or another PR in the block: " + ", ".join(um[:6])))
            continue
        carried.append(p)
    if len(carried) < 2:
        return None, skipped
    # crumbs: recompile once for the whole block in repos that still gate on them
    _, always, _ = run(["git", "show", "origin/main:.aien/always"], cwd=wt)
    if "CRUMB-VERIFY" in always:
        rc, out, err = run(["crumb", "compile", "."], cwd=wt, timeout=900)
        _, ch, _ = run("git status --porcelain | awk '{print $2}' | grep -E '(\\.crumb$|crumb\\.lock$)' || true", cwd=wt)
        files = [f for f in ch.split() if f]
        if files:
            run(["git", "add", "--"] + files, cwd=wt)
            run(["git", "commit", "-q", "-m", "block: recompile crumbs once for the carried PRs"], cwd=wt)
    for candidate in carried:
        admitted, reason = remote_admitted(repo, full, candidate)
        if not admitted:
            raise RuntimeError('block publication refused: ' + reason)
    rc, out, err = run(["git", "push", "-q", "origin", f"HEAD:refs/heads/{b}"], cwd=wt, timeout=900)
    if rc != 0:
        raise RuntimeError("push failed: " + err[-200:])
    _, sha, _ = run(["git", "rev-parse", "HEAD"], cwd=wt)
    nums = [p["number"] for p in carried]
    body = ("Desk block built by renda-harness: one judge run for %d pull requests instead of %d "
            "(Drake 2026-10-20: do the shared work once, in blocks).\n\nWhen this merges, each carried PR is closed with a "
            "link here. If the judge fails, the block is split and retried in halves; nothing is waived.\n\n" % (len(nums), len(nums))
            + "\n".join(f"Carries #{p['number']} ({p['headRefName']}@{p['headRefOid'][:8]}): {p['title']}" for p in carried)
            + ("\n\nNot carried (left for their own path):\n" + "\n".join(f"- #{p['number']}: {why}" for p, why in skipped) if skipped else ""))
    bf = f"{LOGDIR}/block-{repo}-{ts}.md"
    open(bf, "w").write(body)
    for candidate in carried:
        admitted, reason = remote_admitted(repo, full, candidate)
        if not admitted:
            raise RuntimeError('block PR publication refused: ' + reason)
    rc, out, err = run(["gh", "pr", "create", "-R", full, "--head", b, "--base", "main",
                        "--title", f"desk block: {len(nums)} PRs ({', '.join('#%d' % n for n in nums[:8])}{'...' if len(nums) > 8 else ''})",
                        "--body-file", bf], timeout=180)
    if rc != 0:
        raise RuntimeError("pr create failed: " + (err or out)[-200:])
    m = re.search(r"/pull/(\d+)", out)
    return {"pr": int(m.group(1)) if m else None, "branch": b, "sha": sha.strip(), "carried": nums,
            "heads": {str(p["number"]): p["headRefOid"] for p in carried}, "at": ts}, skipped


def queue_block_head(repo, sha):
    """Ask the Spark judge for the block head now (L309): the worker serves trigger files and
    judges an open block head before every other head of the repo."""
    try:
        d = f"{HOME}/.local/state/aien-local-ci/trigger"
        os.makedirs(d, exist_ok=True)
        with open(f"{d}/{repo}.{sha}", "w") as f:
            f.write(f"manual 0000000000000000000000000000000000000000 {sha} {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\n")
    except OSError as e:
        log(f"cannot queue block head {repo} {sha[:8]}: {e}")


def finish_block(repo, full, st, prs_by_num, res):
    """Handle the open block PR: merged -> close carried; failed -> split; else wait."""
    blk = st["open"]
    try:
        d = gh_json(["pr", "view", str(blk["pr"]), "-R", full, "--json", "state,mergeCommit,headRefOid,mergeStateStatus"])
        if not isinstance(d, dict) or d.get("state") not in ("OPEN", "CLOSED", "MERGED"):
            raise RuntimeError("invalid block PR response")
        if d["state"] == "OPEN" and (not re.fullmatch(r"[0-9a-f]{40}", str(d.get("headRefOid", "")))
                                      or not isinstance(d.get("mergeStateStatus"), str)):
            raise RuntimeError("incomplete open block PR response")
        if d["state"] == "MERGED" and not (isinstance(d.get("mergeCommit"), dict)
                                             and re.fullmatch(r"[0-9a-f]{40}", str(d["mergeCommit"].get("oid", "")))):
            raise RuntimeError("merged block lacks a verified merge commit")
    except Exception as e:
        res["waiting"].append(f"block #{blk['pr']} unreadable: {e}")
        return
    if d["state"] == "MERGED":
        if d.get('headRefOid') != blk.get('sha') or not lane_owned(repo):
            res['waiting'].append('merged block identity or ownership changed, carried PRs retained')
            return
        mc = (d.get("mergeCommit") or {}).get("oid", "")[:8]
        for n in blk["carried"]:
            p = prs_by_num.get(n)
            if not p or p['headRefOid'] != blk.get('heads', {}).get(str(n)):
                res['waiting'].append(f'#{n} carried head moved or unavailable, close held')
                return
            admitted, reason = remote_admitted(repo, full, p, merge=True)
            if not admitted:
                res['waiting'].append(f'#{n} carried close held: {reason}')
                return
            rc, _, err = run(["gh", "pr", "close", str(n), "-R", full, "--comment",
                              f"Carried by desk block #{blk['pr']}, merged to main as {mc} after the Spark judge passed on the block head. Closing as merged through the block."])
            res["merged"].append(f"#{n} via block #{blk['pr']} -> {mc}" + ("" if rc == 0 else f" (close failed: {err[-80:]})"))
            if rc:
                res['waiting'].append(f'#{n} close incomplete, block state retained')
                return
        st["open"] = None
        st["size"] = BLOCK_MAX
        save_block(repo, st)
        return
    if d["state"] == "CLOSED":
        st["open"] = None
        save_block(repo, st)
        return
    if blk.get('sha') and d['headRefOid'] != blk['sha']:
        res['waiting'].append('block head moved, no close or split authorized')
        return
    # Use the one per-repo batch rather than polling one status endpoint per PR.
    block_pr = prs_by_num.get(blk['pr'])
    s, desc = queued_status(block_pr) if block_pr else ('none', '')
    if s not in ("failure",) and not (s == "error" and "PIPELINE_CONFIG_CHANGED" not in desc):
        # The Spark judge's own verdict counts even when no GitHub status was posted
        # (operator runs log to ~/handoffs/renda-local, not to the PR). Without this a
        # failed block head froze every carried PR (omega 10-20 to 10-22).
        v = operator_verdict(repo, d["headRefOid"])
        if v and v[0] == "FAIL":
            s, desc = "failure", f"operator verdict FAIL {v[1]}"
    if s in ("failure",) or (s == "error" and "PIPELINE_CONFIG_CHANGED" not in desc):
        if not block_pr:
            res['waiting'].append('block metadata unavailable, split held')
            return
        admitted, reason = remote_admitted(repo, full, block_pr)
        if not admitted:
            res['waiting'].append('block close held: ' + reason)
            return
        res["blocked"].append(f"block #{blk['pr']} judge {s}: {desc[:160]}; splitting")
        rc, _, err = run(["gh", "pr", "close", str(blk["pr"]), "-R", full, "--delete-branch", "--comment",
             f"Judge {s} on the block head ({desc[:200]}). Splitting the block in halves; each half is judged on its own."])
        if rc:
            res['waiting'].append('block close failed; state retained: ' + err[-200:])
            return
        if len(blk["carried"]) <= 2:
            st["solo"] = sorted(set(st.get("solo", []) + blk["carried"]))
        st["size"] = max(2, len(blk["carried"]) // 2)
        st["last_failed"] = blk["carried"]
        st["open"] = None
        save_block(repo, st)
        return
    res["waiting"].append(f"block #{blk['pr']} ({len(blk['carried'])} PRs) {d['mergeStateStatus']} spark={s}")


def remote_admitted(repo, full, pinned, merge=False):
    """Never reuse local review/cache as a statement of present remote eligibility."""
    if not lane_owned(repo) or held(repo, pinned['number']):
        return False, 'ownership or hold changed'
    if merge and os.path.exists(PAUSE):
        return False, 'MERGE-PAUSE'
    try:
        from local_queue import decode_one, graphql_args
        fresh = decode_one(gh_json(graphql_args(full, number=pinned['number'])))
        if (not valid_pr(fresh) or fresh['state'] != 'OPEN' or fresh['isDraft']
                or fresh['headRefOid'] != pinned['headRefOid']
                or fresh['baseRefOid'] != pinned['baseRefOid']):
            return False, 'remote head/base moved, closed, draft or malformed'
        if not merge:
            if queued_status(fresh) != queued_status(pinned):
                return False, 'remote verdict changed after sync; action held'
            retained = operator_verdict(repo, pinned['headRefOid'])
            if retained and retained[0] == 'FAIL' and queued_status(pinned)[0] != 'failure':
                return False, 'retained failure arrived after sync; action held'
        if merge:
            if fresh['mergeStateStatus'] != 'CLEAN':
                return False, 'remote merge state is not CLEAN'
            protection = gh_json(['api', f"repos/{full}/branches/{fresh['baseRefName']}/protection/required_status_checks"])
            if not isinstance(protection, dict) or not isinstance(protection.get('contexts'), list):
                return False, 'required contexts unreadable'
            required = set(protection['contexts'])
            for check in protection.get('checks', []):
                required.add(check['context'])
            if not required:
                return False, 'required contexts empty'
            required.update((SPARK, HOSTED))
            for context in required:
                checks = [s for s in fresh['statusCheckRollup'] if isinstance(s, dict)
                          and (s.get('context') or s.get('name')) == context]
                if not checks or any(str(s.get('state') or s.get('conclusion')).upper() != 'SUCCESS'
                                     or (s.get('name') and s.get('status') != 'COMPLETED') for s in checks):
                    return False, f'required context {context} not successful on fresh head'
            queue = Queue(STATE, repo, full, run, CLONES, WORK)
            source, repository = queue.source(pinned['headRefOid'], pinned['baseRefOid'])
            if source is None or not queue.receipt(source, repository, pinned['headRefOid'], pinned['baseRefOid'])['eligible']:
                return False, 'verified exact-source receipt and PASS plan required'
        if not lane_owned(repo) or held(repo, pinned['number']) or (merge and os.path.exists(PAUSE)):
            return False, 'ownership/hold/pause changed during checks'
        return True, 'fresh exact head'
    except Exception as exc:
        return False, f'fresh remote check unavailable: {exc}'



def site_required_status_contract(full):
    """Read active required-check rules; absence means none required, not qualified."""
    endpoint = f'repos/{full}/branches/main/protection/required_status_checks'
    rc, out, err = run(['gh', 'api', endpoint], timeout=60)
    if rc:
        if 'HTTP 404' not in (out + err):
            return None, f'branch protection lookup failed: {(err or out)[-200:]}'
        protection = None
    else:
        try:
            protection = json.loads(out)
        except (ValueError, TypeError):
            return None, 'branch protection response is malformed'
    rc, out, err = run(['gh', 'api', f'repos/{full}/rulesets?includes=rules'], timeout=60)
    if rc:
        return None, f'ruleset lookup failed: {(err or out)[-200:]}'
    try:
        rulesets = json.loads(out)
        return site_required_checks(protection, rulesets), None
    except (ValueError, TypeError) as exc:
        return None, f'branch rules are malformed: {exc}'


def site_publish_ready(repo, queue, entry, model, policy):
    """Publish one Mac-qualified site READY head through the guarded gh transport only."""
    full = SITE_REPOSITORY
    tag = f"{entry.get('ref')}@{str(entry.get('sha', ''))[:12]}"
    if not lane_owned(repo):
        return False, f"{tag} publication held: lane is not owned by renda"
    if full != queue.full or repository_identity(repo) != full:
        return False, f"{tag} publication held: repository identity mismatch"
    sha, base, ref = entry.get('sha'), entry.get('base'), entry.get('ref')
    if not isinstance(sha, str) or not re.fullmatch(r'[0-9a-f]{40}', sha) or not isinstance(base, str) or not re.fullmatch(r'[0-9a-f]{40}', base):
        return False, f"{tag} publication held: malformed source pins"
    if not isinstance(ref, str) or run(['git', 'check-ref-format', '--branch', ref])[0] != 0:
        return False, f"{tag} publication held: invalid branch ref"
    key = entry.get('key')
    if key != f"{full}:ready:{ref}@{sha}":
        return False, f"{tag} publication held: READY queue key mismatch"
    ack_path = queue.root / 'acks' / (digest(json.dumps([full, [key]], sort_keys=True).encode()) + '.json')
    ack = read(ack_path)
    ack_items = ack.get('items', []) if isinstance(ack, dict) else []
    ack_state = ack.get('state') if isinstance(ack, dict) else None
    state_valid = ((ack_state == 'ACCEPTED_LOCAL_NOT_PUBLISHED' and ack.get('remote_eligible') is False)
        or (ack_state == 'PR_OPEN_CLEAN_PUBLICATION_PENDING_REVIEW' and ack.get('remote_eligible') is True
            and type(ack.get('pr_number')) is int and ack['pr_number'] > 0))
    if (not isinstance(ack, dict) or ack.get('schema') != 'renda-intake-ack/1'
            or ack.get('repository') != full or not state_valid
            or not any(isinstance(row, dict) and row.get('ref') == ref and row.get('head') == sha
                       and row.get('base') == base and row.get('number') is None
                       and row.get('remote_observed_at') is None for row in ack_items)):
        return False, f"{tag} publication held: exact local intake acknowledgement missing"
    plan_path = queue.root / 'local' / repo / digest(key.encode())
    plan_file = Path(str(plan_path) + '.plan.json')
    plan = read(plan_file) if plan_file.is_file() else None
    if (not isinstance(plan, dict) or plan.get('repository') != 'github.com/' + full
            or plan.get('commit') != sha or plan.get('base') != base
            or plan.get('model') != model or plan.get('policy') != policy
            or plan.get('review', {}).get('decision') is not True):
        return False, f"{tag} publication held: exact complete local review missing"
    source, source_repo = queue.source(sha, base)
    if source is None or source_repo != 'github.com/' + full:
        return False, f"{tag} publication held: trusted exact repository source unavailable"
    rc, diff, err = run(['git', '-C', str(source), 'diff', '--no-ext-diff', '--no-textconv', base + '...' + sha, '--'], timeout=120)
    if rc or digest(diff.encode()) != plan.get('diff_digest'):
        return False, f"{tag} publication held: source diff changed or unavailable"
    qualification_root = queue.root / 'site-qualification'
    qualification = verify_site_qualification(qualification_root / (sha + '.json'),
        qualification_root / (sha + '.sig'), source, full, sha)
    if not qualification.get('eligible'):
        return False, f"{tag} publication held: {qualification.get('diagnostic', 'qualification unavailable')}"
    rc, branch_out, err = run(['git', '-C', str(source), 'ls-remote', 'origin', 'refs/heads/' + ref], timeout=60)
    if rc:
        return False, f"{tag} publication held: remote branch read failed"
    rc, base_out, err = run(['git', '-C', str(source), 'ls-remote', 'origin', 'refs/heads/main'], timeout=60)
    if rc or not exact_remote_refs(branch_out, base_out, ref, sha, base):
        return False, f"{tag} publication held: remote branch or main moved from exact READY pins"
    required_checks, rules_error = site_required_status_contract(full)
    if rules_error:
        return False, f"{tag} publication held: {rules_error}"
    rc, merged_tree, err = run(['git', '-C', str(source), 'merge-tree', '--write-tree', base, sha], timeout=60)
    if rc:
        return False, f"{tag} publication held: candidate does not merge cleanly with pinned main"
    response = run(['gh', 'pr', 'list', '-R', full, '--head', ref, '--state', 'all', '--json',
        'number,state,headRefName,headRefOid,baseRefName,baseRefOid'], timeout=120)
    if response[0] != 0:
        return False, f"{tag} publication held: existing PR lookup failed: {(response[2] or response[1])[-200:]}"
    try:
        rows = json.loads(response[1])
    except (ValueError, TypeError):
        rows = None
    inspected = inspect_site_pr_snapshot(rows, ref, sha, base)
    if inspected['action'] == 'refuse':
        return False, f"{tag} publication held: {inspected['reason']}"
    if inspected['action'] == 'reuse':
        number = inspected['number']
    else:
        body = (f"Renda website intake\n\nRepository: {full}\nBranch: {ref}\n"
            f"Head: {sha}\nBase: main@{base}\nQualification: {qualification['recipe_id']}"
            f"\nReceipt SHA-256: {qualification['receipt_sha256']}\n"
            f"Local full-diff review: approved by {model}\nNo Spark gate is claimed or run."
            f"\nThis intake does not authorize merging.")
        title = f"Renda website intake: {ref}"[:240]
        rc, out, err = run(['gh', 'pr', 'create', '-R', full, '--head', ref, '--base', 'main',
            '--title', title, '--body', body], timeout=120)
        if rc:
            return False, f"{tag} publication held: guarded PR create refused: {(err or out)[-240:]}"
        match = re.search(r'/pull/(\d+)', out.strip())
        if not match:
            return False, f"{tag} publication ambiguous: create response has no PR number; reconcile exact branch before retry"
        number = int(match[1])
    try:
        pr = gh_json(['pr', 'view', str(number), '-R', full, '--json',
            'number,state,headRefName,headRefOid,baseRefName,baseRefOid,mergeStateStatus,statusCheckRollup'])
    except Exception as exc:
        return False, f"{tag} publication pending: PR #{number} readback failed: {exc}"
    if (not isinstance(pr, dict) or type(pr.get('number')) is not int or pr['number'] != number
            or pr.get('state') != 'OPEN' or pr.get('headRefName') != ref or pr.get('headRefOid') != sha
            or pr.get('baseRefName') != 'main' or pr.get('baseRefOid') != base
            or pr.get('mergeStateStatus') != 'CLEAN'):
        return False, f"{tag} publication pending: PR #{number} is malformed, moved, closed or not CLEAN"
    if not required_checks_satisfied(required_checks, pr.get('statusCheckRollup')):
        return False, f"{tag} publication pending: PR #{number} required branch checks are missing or not successful"
    ack['state'] = 'PR_OPEN_CLEAN_PUBLICATION_PENDING_REVIEW'
    ack['remote_eligible'] = True
    ack['pr_number'] = number
    ack['remote_observed_at'] = time.time()
    ack['qualification'] = qualification
    save(ack_path, ack)
    return True, f"{tag} published as PR #{number}; exact head/base read back CLEAN; merge remains desk-controlled"


def site_lane_pass(repo, full, queue):
    result = {"repo": repo, "merged": [], "rebased": [], "rerun": [], "operator": [],
              "blocked": [], "waiting": [], "local": [], "sync_wait": []}
    snapshot, synced = queue.sync()
    with open(SOURCE_FILE, 'rb') as f:
        policy_source = f.read()
    from local_queue import __file__ as queue_source
    with open(queue_source, 'rb') as f:
        policy_source += f.read()
    from site_policy import __file__ as site_policy_source
    with open(site_policy_source, 'rb') as f:
        policy_source += f.read()
    policy = hashlib.sha256(policy_source).hexdigest()
    mid = model_id()
    result['local'] = queue.progress(snapshot, mid, ask_model, policy)
    if not synced:
        result['sync_wait'].append('waiting-for-sync: ' + (queue.sync_diagnostic or 'fresh remote state unavailable'))
        return result
    with queue.lock('publish') as owned:
        if not owned:
            result['waiting'].append('site publication lock held by another worker')
            return result
        for entry in snapshot['entries']:
            if entry.get('kind') != 'ready':
                continue
            ok, note = site_publish_ready(repo, queue, entry, mid, policy)
            if ok or 'publication pending:' in note or 'publication ambiguous:' in note:
                result['waiting'].append(note)
            else:
                result['blocked'].append(note)
        for entry in snapshot['entries']:
            if entry.get('kind') == 'pr' and entry.get('active'):
                pr = entry['pr']
                result['waiting'].append(f"PR #{pr['number']} awaits independent desk merge review; website lane never auto-merges")
    return result


def lane_pass(repo):
    full, repo_policy = repository_policy(repo)
    res = {"repo": repo, "merged": [], "rebased": [], "rerun": [], "operator": [], "blocked": [], "waiting": []}
    if not lane_owned(repo):
        res["blocked"].append("lane no longer names renda; skipped")
        return res
    queue = Queue(STATE, repo, full, run, CLONES, WORK)
    if full == SITE_REPOSITORY:
        return site_lane_pass(repo, full, queue)
    snapshot, synced = queue.sync()
    with open(SOURCE_FILE, 'rb') as source:
        policy_source = source.read()
    from local_queue import __file__ as queue_source
    with open(queue_source, 'rb') as source:
        policy_source += source.read()
    from site_policy import __file__ as site_policy_source
    with open(site_policy_source, 'rb') as source:
        policy_source += source.read()
    policy = hashlib.sha256(policy_source).hexdigest()
    mid = model_id()
    res["local"] = queue.progress(snapshot, mid, ask_model, policy)
    res["sync_wait"] = []
    if not synced:
        res["sync_wait"].append("waiting-for-sync: " + (queue.sync_diagnostic or "cached metadata only"))
        return res
    prs = [e["pr"] for e in snapshot["entries"] if e["kind"] == "pr" and e.get("active") and not e["pr"]["isDraft"]]
    prs.sort(key=lambda p: p["number"])   # oldest first: the backlog drains in order
    paused = os.path.exists(PAUSE)
    merged_one = False
    waiting = 0
    rows = []
    for p in prs:
        st, desc = queued_status(p)
        # A locally retained failure remains a failure when status publication is unavailable.
        try:
            retained = operator_verdict(repo, p['headRefOid'])
        except (TypeError, AttributeError):
            retained = ('HOLD', 'malformed retained verdict')
        if retained and retained[0] == 'FAIL':
            st, desc = 'failure', 'retained local FAIL: ' + retained[1]
        elif retained and retained[0] == 'HOLD':
            st, desc = 'failure', retained[1]
        rows.append((p, st, desc))
    bst = load_block(repo)
    if bst.get("open"):
        finish_block(repo, full, bst, {p["number"]: p for p in prs}, res)
    carried_now = set(bst["open"]["carried"]) if bst.get("open") else set()
    block_cands = []
    for p, st, desc in rows:
        n, sha, ms, title = p["number"], p["headRefOid"], p["mergeStateStatus"], p["title"]
        tag = f"#{n} {sha[:8]}"
        h = held(repo, n)
        if h:
            res["blocked"].append(f"{tag} held: {h}")
            continue
        if ms == "CLEAN" and st == "success":
            if paused or merged_one:
                res["waiting"].append(f"{tag} ready ({'MERGE-PAUSE' if paused else 'one merge per repo per pass'})")
                continue
            ok, note = queue.review(p, mid, policy)
            if ok is None:
                res["waiting"].append(f"{tag} ready, review waiting: {note}")
                continue
            if not ok:
                res["blocked"].append(f"{tag} review refused: {note}")
                continue
            ok, reason = remote_admitted(repo, full, p, merge=True)
            if not ok:
                res["waiting"].append(f"{tag} publish held: {reason}")
                continue
            rc, out, err = run(["gh", "pr", "merge", str(n), "-R", full, "--squash", "--match-head-commit", sha])
            if rc == 0:
                d = gh_json(["pr", "view", str(n), "-R", full, "--json", "state,mergedAt,mergeCommit"])
                if d and d.get("state") == "MERGED":
                    mc = (d.get("mergeCommit") or {}).get("oid", "")[:8]
                    res["merged"].append(f"{tag} -> {mc}: {title[:70]} | {note}")
                    with open(f"{HOME}/.claude/jobs/cc26184e/tmp/merged.log", "a") as f:
                        f.write(f"{time.strftime('%FT%TZ', time.gmtime())} {full}#{n} {sha} -> {mc} by renda-harness/{NAME}\n")
                    merged_one = True
                    continue
            res["blocked"].append(f"{tag} merge failed: {(err or out).strip()[-200:]}")
        elif st == "success" and ms in ("BLOCKED", "UNSTABLE"):
            admitted, reason = remote_admitted(repo, full, p)
            ok, note = hosted_rerun(full, sha, repo) if admitted else (False, reason)
            (res["rerun"] if ok else res["waiting"]).append(f"{tag} {note}")
        elif n in carried_now:
            res["waiting"].append(f"{tag} carried by block #{bst['open']['pr']}")
        elif title.startswith("desk block:") and "PIPELINE_CONFIG_CHANGED" not in desc:
            continue
        elif st in REBASE_STATES and n not in bst.get("solo", []) and not title.startswith("desk block:"):
            block_cands.append(p)
        elif "PIPELINE_CONFIG_CHANGED" in desc and (ms != "DIRTY" or title.startswith("desk block:")):
            admitted, reason = remote_admitted(repo, full, p)
            ok, note = operator_run(repo, sha) if admitted else (False, reason)
            (res["operator"] if ok else res["waiting"]).append(f"{tag} {note}")
        elif ms in ("DIRTY", "BEHIND") and st in REBASE_STATES:
            admitted, reason = remote_admitted(repo, full, p)
            ok, note = rebase(repo, full, n, p["headRefName"], sha) if admitted else (False, reason)
            (res["rebased"] if ok else res["blocked"]).append(f"{tag} solo: {note}")
        elif st in ("failure", "error"):
            res["blocked"].append(f"{tag} Spark {st}: {desc[:140]}")
        else:
            res["waiting"].append(f"{tag} {ms} spark={st}")
    if block_cands and not bst.get("open") and lane_owned(repo):
        size = bst.get("size", BLOCK_MAX)
        last = bst.get("last_failed")
        pool = [p for p in block_cands if (not last or p["number"] in last)] or block_cands
        pick = pool[:size]
        if len(pick) >= 2:
            try:
                blk, skipped = build_block(repo, full, pick, res)
            except Exception as e:
                blk, skipped = None, []
                res["blocked"].append(f"block build failed: {e}")
            for p, why in skipped:
                res["blocked"].append(f"#{p['number']} not in block: {why}")
            if blk and blk.get("pr"):
                bst["open"] = blk
                queue_block_head(repo, blk["sha"])
                if last:
                    rest = [x for x in last if x not in blk["carried"]]
                    bst["last_failed"] = rest or None
                save_block(repo, bst)
                res["rebased"].append(f"block #{blk['pr']} opened carrying {', '.join('#%d' % x for x in blk['carried'])} (head {blk['sha'][:8]}); one judge run for all")
        elif len(pick) == 1:
            bst["solo"] = sorted(set(bst.get("solo", []) + [pick[0]["number"]]))
            save_block(repo, bst)
    return res


def safe_lane_pass(repo):
    """An unreadable lane must not terminate unrelated lanes or the desk loop."""
    try:
        return lane_pass(repo)
    except Exception as exc:
        return {"repo": repo, "merged": [], "rebased": [], "rerun": [], "operator": [],
                "blocked": [f"lane error (no successful action claimed): {type(exc).__name__}: {exc}"],
                "waiting": []}


def report(results):
    acted = any(r["merged"] or r["rebased"] or r["rerun"] or r["operator"] for r in results)
    lines = []
    for r in results:
        for k in ("local", "sync_wait", "merged", "rebased", "rerun", "operator", "blocked", "waiting"):
            for item in r.get(k, []):
                lines.append(f"  {r['repo']} {k.upper()} {item}")
    for l in lines:
        log(l.strip())
    if acted:
        with open(DESKLOG, "a") as f:
            f.write(f"\n{time.strftime('%FT%TZ', time.gmtime())} renda-harness({NAME}):\n")
            for l in lines:
                if " BLOCKED " in l or " WAITING " in l:
                    continue
                f.write(l + "\n")
    return acted


def main():
    global NAME, LOGF
    ap = argparse.ArgumentParser()
    ap.add_argument("--name", default="renda1")
    ap.add_argument("--lanes")
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--rest", type=int, default=60)
    ap.add_argument('--seed-ready', help='import explicit local READY JSON for one --lanes repo, without remote calls')
    ap.add_argument("--operator-check", nargs=2, metavar=("REPO", "SHA"),
                    help="print what the operator step would do for this head, then exit (test hook)")
    a = ap.parse_args()
    if a.seed_ready:
        if not a.lanes or ',' in a.lanes:
            ap.error('--seed-ready requires exactly one --lanes repo')
        repo = a.lanes
        full = repository_identity(repo)
        ack = Queue(STATE, repo, full, run, CLONES, WORK).seed_ready(a.seed_ready)
        print(json.dumps(ack, sort_keys=True))
        return
    if a.operator_check:
        ok, note = operator_run(*a.operator_check)
        print(("ACT " if ok else "SKIP ") + note)
        return
    if not a.lanes:
        ap.error("--lanes is required")
    NAME = a.name
    os.makedirs(LOGDIR, exist_ok=True)
    LOGF = f"{LOGDIR}/harness-{NAME}.log"
    lk = open(f"{STATE}/renda-harness-{NAME}.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)
    lanes = [x.strip() for x in a.lanes.split(",") if x.strip()]
    log(f"start lanes={','.join(lanes)} model={model_id()}")
    while True:
        t0 = time.time()
        with ThreadPoolExecutor(max_workers=len(lanes)) as ex:
            results = list(ex.map(safe_lane_pass, lanes))
        report(results)
        log("pass done in %d s: merged %d, rebased %d, reruns %d, operator runs %d" % (
            time.time() - t0, sum(len(r["merged"]) for r in results), sum(len(r["rebased"]) for r in results),
            sum(len(r["rerun"]) for r in results), sum(len(r["operator"]) for r in results)))
        if a.once:
            break
        time.sleep(a.rest)


if __name__ == "__main__":
    main()
