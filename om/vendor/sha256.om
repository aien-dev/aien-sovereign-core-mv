note SPDX-License-Identifier: Apache-2.0
note Vendored from aien-dev/benchmarks-mv om/data/sha256.om at 567c5da595ebc9abebcd4dd195b1b8d7fb7507f4 (branch
note refactor/om-rewrite), written before that repository adopted Apache-2.0 tree-wide (d3f3b40).
note Header and hash-state global name differ (hstate avoids the ECDSA hs parameter); algorithm unchanged.
note Incremental SHA-256 in native Omega. No runtime library calls.
note Algorithm and constants checked against Omega seed/atlas/atlas.s2 and src/sha256.c
note at seed ancestor 29b12760. Those files are references, never build inputs.
note hmeta: buffered bytes, message bytes, state (0 active, 1 finalized, 2 error).
note hfinal exposes 64 lowercase hexadecimal bytes in hd; reset before another message.
global hk uint 64
global hstate uint 8
global hm uint 64
global hb uchar 64
global hd uchar 64
global hmeta ulong 3
text hconst ""
text hseed "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19"
text hhex "0123456789abcdef"

fn hnibble c uchar to uint
if le c 57
ret uint sub c 48
end
ret uint sub c 87
end

fn hreset to void
for i ulong 64
v = uint 0
for j ulong 8
v = or shl v 4 hnibble get hconst add mul i 8 j
end
put hk i v
end
for i ulong 8
v = uint 0
for j ulong 8
v = or shl v 4 hnibble get hseed add mul i 8 j
end
put hstate i v
end
for i ulong 3
put hmeta i 0
end
end

fn hrot x uint n uint to uint
ret or shr x n shl x sub 32 n
end

fn hsmall0 x uint to uint
ret xor xor hrot x 7 hrot x 18 shr x 3
end

fn hsmall1 x uint to uint
ret xor xor hrot x 17 hrot x 19 shr x 10
end

fn hbig0 x uint to uint
ret xor xor hrot x 2 hrot x 13 hrot x 22
end

fn hbig1 x uint to uint
ret xor xor hrot x 6 hrot x 11 hrot x 25
end

fn hblock to void
for i ulong 16
v = uint 0
for j ulong 4
v = or shl v 8 uint get hb add mul i 4 j
end
put hm i v
end
for j ulong 48
i = add j 16
v = add hsmall1 get hm sub i 2 get hm sub i 7
v = add v hsmall0 get hm sub i 15
put hm i add v get hm sub i 16
end
a = get hstate 0
b = get hstate 1
c = get hstate 2
d = get hstate 3
e = get hstate 4
f = get hstate 5
g = get hstate 6
h = get hstate 7
for i ulong 64
t1 = add h hbig1 e
t1 = add t1 xor and e f and not e g
t1 = add t1 get hk i
t1 = add t1 get hm i
t2 = hbig0 a
t2 = add t2 xor xor and a b and a c and b c
h = g
g = f
f = e
e = add d t1
d = c
c = b
b = a
a = add t1 t2
end
put hstate 0 add get hstate 0 a
put hstate 1 add get hstate 1 b
put hstate 2 add get hstate 2 c
put hstate 3 add get hstate 3 d
put hstate 4 add get hstate 4 e
put hstate 5 add get hstate 5 f
put hstate 6 add get hstate 6 g
put hstate 7 add get hstate 7 h
end

fn hraw c uchar to void
n = get hmeta 0
put hb n c
n = add n 1
if eq n 64
hblock
n = ulong 0
end
put hmeta 0 n
end

fn hpush c uchar to bool
if ne get hmeta 2 0
ret false
end
if eq get hmeta 1 2305843009213693951
put hmeta 2 2
ret false
end
hraw c
put hmeta 1 add get hmeta 1 1
ret true
end

fn hfinal to bool
if ne get hmeta 2 0
ret false
end
bits = mul get hmeta 1 8
hraw 128
while ne get hmeta 0 56
hraw 0
end
for i ulong 8
shift = mul sub 7 i 8
hraw uchar and shr bits shift 255
end
for i ulong 8
v = get hstate i
for j ulong 8
shift = uint mul sub 7 j 4
digit = ulong and shr v shift 15
put hd add mul i 8 j get hhex digit
end
end
put hmeta 2 1
ret true
end
