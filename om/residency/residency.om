note SPDX-License-Identifier: Apache-2.0
note Expert residency simulator in seeded Omega (sc#630 residency question, host only).
note Replays a recorded MoE router trace against a per-layer expert cache of capacity C and counts
note hits and misses for two eviction policies: LRU (online) and OPT (Belady, offline bound).
note Input on stdin, ASCII decimal numbers separated by spaces, tabs or newlines:
note   E L K T, then T*L*K expert ids in step-major order (step t, layer l, slot k), each below E.
note Limits: 1 <= E <= 1024, 1 <= K <= 16, 1 <= L, 2 <= T, T*K <= 1048576, T*L*K <= 8388608,
note input at most 16 MiB. Ids inside one step and layer must be distinct.
note Output: one header line, then one line per policy and capacity percent in pc:
note   POLICY cap=C pct=P hits=H miss=M warm_miss=W warm_acc=A
note warm counts only steps t >= T/2, so compulsory first-touch misses mostly fall outside them.
note Eviction never removes an expert already used in the current step (all K are needed at once).
note Exit: 0 ok, 2 read error, 3 input over 16 MiB, 4 header out of range, 5 bad or missing number,
note 6 trailing bytes, 7 id out of range, 8 repeated id in one step, 9 write error.
global inb uchar 16777216
global ids ushort 8388608
global nxt ulong 1048576
global stp ulong 1024
global nu ulong 1024
global lst ulong 1024
note hd: 0 E, 1 L, 2 K, 3 T, 4 parse position, 5 input length.
global hd ulong 8
note ac: 0 hits, 1 misses, 2 warm misses, 3 resident count.
global ac ulong 8
global pc ulong 8
global ob uchar 8192
global ow ulong 1
text lit "trace E=~ L=~ K=~ T=~\n~lru ~opt ~cap=~ pct=~ hits=~ miss=~ warm_miss=~ warm_acc=~ "

note slurp: read all of stdin into inb. Each inner pass adds at least one byte or ends, so
note 64 outer passes of 999999 cover the 16777216-byte buffer.
fn slurp to int
n = ulong 0
for r ulong 64
while lt n len inb bound 999999
k = read 0 inb n sub len inb n
if lt k 0
ret 2
end
if eq k 0
put hd 5 n
ret 0
end
n = add n ulong k
end
end
ret 3
end

note isws: byte c is a space, tab, carriage return or newline.
fn isws c uchar to bool
ret or or eq c 32 eq c 10 or eq c 9 eq c 13
end

note skip: advance the parse position past white space; return the new position.
fn skip to ulong
p = get hd 4
n = get hd 5
while lt p n bound 999999
if not isws get inb p
break
end
p = add p 1
end
put hd 4 p
ret p
end

note num: next decimal number (at most 20 digits); exit 5 when none is there.
fn num to ulong
p = skip
n = get hd 5
v = ulong 0
d = ulong 0
while lt p n bound 21
c = get inb p
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
p = add p 1
d = add d 1
end
if eq d 0
exit 5
end
if lt p n
if not isws get inb p
exit 5
end
end
put hd 4 p
ret v
end

note badd: append byte c to ob.
fn badd c uchar to void
w = get ow 0
if ge w len ob
exit 9
end
put ob w c
put ow 0 add w 1
end

note frag: append fragment k of lit (fragments separated by ~, byte 126).
fn frag k ulong to void
c = ulong 0
for i ulong len lit
b = get lit i
if eq b 126
c = add c 1
else
if eq c k
badd b
end
end
end
end

note dec: append v in decimal.
fn dec v ulong to void
p = ulong 1
while le p div v 10 bound 20
p = mul p 10
end
while ne p 0 bound 21
badd uchar add div v p 48
v = rem v p
p = div p 10
end
end

note kv: append fragment k, then v in decimal.
fn kv k ulong v ulong to void
frag k
dec v
end

note flush: write ob to stdout, looping over partial writes.
fn flush to int
o = ulong 0
w = get ow 0
while lt o w bound 8193
k = write 1 ob o sub w o
if le k 0
ret 9
end
o = add o ulong k
end
ret 0
end

note slot: index of (step t, layer l, slot k) in ids.
fn slot t ulong l ulong k ulong to ulong
ret add mul add mul t get hd 1 l get hd 2 k
end

note prep: nxt[t*K+k] = next step after t whose layer-l ids contain the id at (t,l,k), else T.
fn prep l ulong to void
t0 = get hd 3
k0 = get hd 2
for e ulong get hd 0
put lst e t0
end
for j ulong t0
t = sub sub t0 1 j
for k ulong k0
id = ulong get ids slot t l k
put nxt add mul t k0 k get lst id
end
for k ulong k0
put lst ulong get ids slot t l k t
end
end
end

note score: eviction preference of resident expert e at step t (larger evicts first).
note LRU (pol 0): least recently used; OPT (pol 1): next use farthest away.
fn score e ulong t ulong pol ulong to ulong
if eq pol 0
ret sub add t 2 get stp e
end
ret get nu e
end

note evict: drop the resident expert with the largest score, lowest id on ties, never one
note already used in step t (stamp t+1).
fn evict t ulong pol ulong to void
best = ulong 0
bv = ulong 0
fnd = false
for e ulong get hd 0
s = get stp e
if and ne s 0 ne s add t 1
v = score e t pol
if or not fnd gt v bv
best = e
bv = v
fnd = true
end
end
end
if not fnd
exit 8
end
put stp best 0
end

note access: one router choice (t,l,k) against cache capacity c.
fn access t ulong l ulong k ulong c ulong pol ulong to void
id = ulong get ids slot t l k
if eq get stp id add t 1
exit 8
end
if ne get stp id 0
put ac 0 add get ac 0 1
else
put ac 1 add get ac 1 1
if ge t div get hd 3 2
put ac 2 add get ac 2 1
end
if ge get ac 3 c
evict t pol
else
put ac 3 add get ac 3 1
end
end
put stp id add t 1
put nu id get nxt add mul t get hd 2 k
end

note simlayer: replay layer l from an empty cache of capacity c.
fn simlayer l ulong c ulong pol ulong to void
for e ulong get hd 0
put stp e 0
put nu e 0
end
put ac 3 0
for t ulong get hd 3
for k ulong get hd 2
access t l k c pol
end
end
end

note run: every layer at capacity c under policy pol; append the result line.
fn run c ulong p ulong pol ulong to void
put ac 0 0
put ac 1 0
put ac 2 0
for l ulong get hd 1
prep l
simlayer l c pol
end
frag add 5 pol
kv 7 c
kv 8 p
kv 9 get ac 0
kv 10 get ac 1
kv 11 get ac 2
t = get hd 3
kv 12 mul mul get hd 1 get hd 2 sub t div t 2
badd 10
end

note load: parse the header and the ids; return 0 or an exit code.
fn load to int
e = num
l = num
k = num
t = num
if or or lt e 1 gt e 1024 or lt k 1 gt k 16
ret 4
end
if or lt l 1 lt t 2
ret 4
end
if or gt t 1048576 gt mul t k 1048576
ret 4
end
if gt l div 8388608 mul t k
ret 4
end
put hd 0 e
put hd 1 l
put hd 2 k
put hd 3 t
for i ulong mul mul t l k
v = num
if ge v e
ret 7
end
put ids i ushort v
end
if lt skip get hd 5
ret 6
end
ret 0
end

fn main to int
r = slurp
if ne r 0
ret r
end
r = load
if ne r 0
ret r
end
put pc 0 25
put pc 1 40
put pc 2 50
put pc 3 60
put pc 4 64
put pc 5 70
put pc 6 80
put pc 7 90
kv 0 get hd 0
kv 1 get hd 1
kv 2 get hd 2
kv 3 get hd 3
frag 4
for pol ulong 2
for j ulong 8
c = div mul get hd 0 get pc j 100
if ge c get hd 2
run c get pc j pol
end
end
end
ret flush
end
