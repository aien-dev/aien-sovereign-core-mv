note ======== output buffers ========

fn fm_eput c uchar to void
p = get gst 14
if lt p 512
put geb p c
put gst 14 add p 1
end
end

fn fm_etx t view uchar * to void
for i ulong len t
fm_eput get t i
end
end

note fm_dec: decimal digits of v into gdg, least significant first; returns the digit count
fn fm_dec v ulong to ulong
n = ulong 0
x = v
while true bound 25
put gdg n add 48 uchar rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
ret n
end

fn fm_eu v ulong to void
n = fm_dec v
for i ulong n
fm_eput get gdg sub sub n i 1
end
end

fn fm_eflush to void
o = ulong 0
m = get gst 14
while lt o m bound 1024
w = write 2 geb o sub m o
if le w 0
exit 3
end
o = add o ulong w
end
put gst 14 0
end

fn fm_die c ulong t view uchar * to void
put gst 14 0
fm_etx tref
fm_eu c
fm_eput 32
fm_etx t
fm_eput 10
fm_eflush
exit int c
end

fn fm_ob c uchar to void
p = get gst 5
if ge p len gob
fm_die 43 tr43
end
put gob p c
put gst 5 add p 1
end

fn fm_otx t view uchar * to void
for i ulong len t
fm_ob get t i
end
end

fn fm_ou v ulong to void
n = fm_dec v
for i ulong n
fm_ob get gdg sub sub n i 1
end
end

note fm_ohdr: the TSV column header line name, shard, dtype, shape, begin, end
fn fm_ohdr to void
fm_otx thname
fm_ob 9
fm_otx thshard
fm_ob 9
fm_otx thdtype
fm_ob 9
fm_otx tshape
fm_ob 9
fm_otx thbegin
fm_ob 9
fm_otx thend
fm_ob 10
end

fn fm_oflush to void
o = ulong 0
m = get gst 5
while lt o m bound 999999
w = write 1 gob o sub m o
if le w 0
fm_die 3 tr3
end
o = add o ulong w
end
end

note ======== tensor names and the canonical slot space ========

note fm_pre: nm[p ..] starts with t (within n bytes); fm_rest: nm[p .. n) equals t exactly
fn fm_pre nm view uchar * n ulong p ulong t view uchar * to bool
if gt p n
ret false
end
if gt len t sub n p
ret false
end
for i ulong len t
if ne get nm add p i get t i
ret false
end
end
ret true
end

fn fm_rest nm view uchar * n ulong p ulong t view uchar * to bool
if not fm_pre nm n p t
ret false
end
ret eq add p len t n
end

note fm_num: a decimal of 1..3 digits at nm[p] without a leading zero, followed by '.';
note returns the value (FMX when malformed) and leaves the position after the '.' in gst 17
fn fm_num nm view uchar * n ulong p ulong to ulong
v = ulong 0
q = p
for i ulong 4
if ge q n
ret FMX
end
c = get nm q
if eq c 46
if eq i 0
ret FMX
end
put gst 17 add q 1
ret v
end
if or lt c 48 gt c 57
ret FMX
end
if and gt i 0 eq v 0
ret FMX
end
v = add mul v 10 ulong sub c 48
q = add q 1
end
ret FMX
end

note fm_kind: the per-layer kind of the name suffix at nm[p ..], FMX when unknown
fn fm_kind nm view uchar * n ulong p ulong to ulong
if fm_rest nm n p tk0
ret 0
end
if fm_rest nm n p tk1
ret 1
end
if fm_rest nm n p tk2
ret 2
end
if fm_rest nm n p tk3
ret 3
end
if fm_rest nm n p tk4
ret 4
end
if fm_rest nm n p tk5
ret 5
end
if fm_rest nm n p tk6
ret 6
end
if fm_rest nm n p tk7
ret 7
end
if fm_rest nm n p tk8
ret 8
end
if fm_rest nm n p tk9
ret 9
end
if fm_rest nm n p tk10
ret 10
end
if fm_rest nm n p tk11
ret 11
end
if fm_rest nm n p tk12
ret 12
end
if fm_rest nm n p tk13
ret 13
end
if fm_rest nm n p tk14
ret 14
end
if fm_rest nm n p tk15
ret 15
end
if not fm_pre nm n p texp
ret FMX
end
e = fm_num nm n add p len texp
if ge e 256
ret FMX
end
q = get gst 17
if fm_rest nm n q tgate
ret add 16 mul e 3
end
if fm_rest nm n q tup
ret add 17 mul e 3
end
if fm_rest nm n q tdown
ret add 18 mul e 3
end
ret FMX
end

note fm_slot: canonical id of a checkpoint tensor name, FMX for any name outside the layout
fn fm_slot nm view uchar * n ulong to ulong
if fm_rest nm n 0 tembed
ret 0
end
if fm_rest nm n 0 tnorm
ret 1
end
if fm_rest nm n 0 tlmh
ret 2
end
if not fm_pre nm n 0 tlayers
ret FMX
end
ly = fm_num nm n len tlayers
if ge ly 49
ret FMX
end
k = fm_kind nm n get gst 17
if eq k FMX
ret FMX
end
if and ge k 9 le k 11
if ge ly 2
ret FMX
end
end
if ge k 12
if lt ly 2
ret FMX
end
end
ret add add 3 mul ly 784 k
end

fn fm_kd s ulong to ulong
if lt s 3
ret add 1000 s
end
ret rem sub s 3 784
end

note fm_ok: whether slot s names a tensor of the pinned layout
fn fm_ok s ulong to bool
if ge s FMNS
ret false
end
if lt s 3
ret true
end
k = fm_kd s
ly = div sub s 3 784
if le k 8
ret true
end
if le k 11
ret lt ly 2
end
ret ge ly 2
end

note fm_d0 / fm_d1: expected shape of slot s from the pinned config (fm_d1 0 means rank 1)
fn fm_d0 s ulong to ulong
k = fm_kd s
if or eq k 1000 eq k 1002
ret 150144
end
if eq k 1001
ret 2048
end
if le k 1
ret 2048
end
if eq k 2
ret 4096
end
if le k 4
ret 512
end
if eq k 5
ret 2048
end
if le k 7
ret 128
end
if eq k 8
ret 32
end
if le k 10
ret 6144
end
if eq k 11
ret 2048
end
if eq k 12
ret 256
end
if le k 14
ret 1024
end
if eq k 15
ret 2048
end
if lt rem sub k 16 3 2
ret 512
end
ret 2048
end

fn fm_d1 s ulong to ulong
k = fm_kd s
if or eq k 1000 eq k 1002
ret 2048
end
if eq k 1001
ret 0
end
if le k 1
ret 0
end
if le k 4
ret 2048
end
if eq k 5
ret 4096
end
if le k 8
ret 0
end
if le k 10
ret 2048
end
if eq k 11
ret 6144
end
if le k 14
ret 2048
end
if eq k 15
ret 1024
end
if lt rem sub k 16 3 2
ret 2048
end
ret 512
end

fn fm_rk s ulong to ulong
if eq fm_d1 s 0
ret 1
end
ret 2
end

fn fm_np s ulong to ulong
d1 = fm_d1 s
if eq d1 0
ret fm_d0 s
end
ret mul fm_d0 s d1
end

note ======== files ========

fn fm_le64 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get gstb add o i mul 8 i
end
ret v
end

fn fm_h64 to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get gh8 i mul 8 i
end
ret v
end

note fm_open: open gpth[0 .. n) with O_RDONLY | O_CLOEXEC | O_NOFOLLOW (arm64 557056), require a
note regular file (st_mode & S_IFMT 61440 == S_IFREG 32768), leave st_size in gst 9
fn fm_open n ulong to long
fd = fopen gpth 0 n 557056 0
if lt fd 0
if eq fd -40
fm_die 4 tr4
end
fm_die 3 tr3
end
r = fstat int fd gstb 0 128
if ne r 0
fm_die 3 tr3
end
note S_IFMT sits in the low 16 bits of st_mode
md = or ulong get gstb 16 shl ulong get gstb 17 8
if ne and md 61440 32768
fm_die 4 tr4
end
put gst 9 fm_le64 48
ret fd
end

fn fm_argp a ulong to ulong
n = get gal a
if or eq n 0 gt n 4095
fm_die 2 tr2
end
o = get gas a
for i ulong n
put gpth i get ga add o i
end
ret n
end

fn fm_pfull fd long b edit uchar * n ulong pos ulong to void
o = ulong 0
while lt o n bound 999999
r = pread int fd b o sub n o long add pos o
if le r 0
fm_die 3 tr3
end
o = add o ulong r
end
end

fn fm_close fd long to void
r = fclose int fd
if ne r 0
fm_die 3 tr3
end
end

fn fm_rcfg src edit uchar * to ulong
fd = fm_open fm_argp 1
n = get gst 9
if or eq n 0 gt n 65536
fm_die 10 tr10
end
fm_pfull fd src n 0
fm_close fd
ret n
end

fn fm_ridx to void
fd = fm_open fm_argp 2
n = get gst 9
if gt n len gx
fm_die 20 tr20
end
o = ulong 0
while lt o n bound 999999
r = pread int fd gx o sub n o long o
if le r 0
fm_die 3 tr3
end
o = add o ulong r
end
fm_close fd
put gst 7 0
put gst 8 n
end

note ======== config admission (every key pinned or explicitly ignored) ========

fn fm_ckey src view uchar * o ulong to ulong
if js_streq src o ck0
ret 0
end
if js_streq src o ck1
ret 1
end
if js_streq src o ck2
ret 2
end
if js_streq src o ck3
ret 3
end
if js_streq src o ck4
ret 4
end
if js_streq src o ck5
ret 5
end
if js_streq src o ck6
ret 6
end
if js_streq src o ck7
ret 7
end
if js_streq src o ck8
ret 8
end
if js_streq src o ck9
ret 9
end
if js_streq src o ck10
ret 10
end
if js_streq src o ck11
ret 11
end
if js_streq src o ck12
ret 12
end
if js_streq src o ck13
ret 13
end
if js_streq src o ck14
ret 14
end
if js_streq src o ck15
ret 15
end
if js_streq src o ck16
ret 16
end
if js_streq src o ck17
ret 17
end
if js_streq src o ck18
ret 18
end
if js_streq src o ck19
ret 19
end
if js_streq src o ck20
ret 20
end
if js_streq src o ck21
ret 21
end
if js_streq src o ck22
ret 22
end
if js_streq src o ck23
ret 23
end
if js_streq src o ck24
ret 24
end
if js_streq src o ck25
ret 25
end
if js_streq src o ck26
ret 26
end
if js_streq src o ck27
ret 27
end
if js_streq src o ck28
ret 28
end
if js_streq src o ck29
ret 29
end
if js_streq src o ck30
ret 30
end
if js_streq src o ck31
ret 31
end
if js_streq src o ck32
ret 32
end
if js_streq src o ck33
ret 33
end
if js_streq src o ck34
ret 34
end
if js_streq src o ck35
ret 35
end
if js_streq src o ck36
ret 36
end
if js_streq src o ck37
ret 37
end
if js_streq src o ck38
ret 38
end
ret FMX
end

note fm_copt: keys that may be absent (ignored for inference, or rope_scaling which must be null)
fn fm_copt id ulong to bool
ret or or or eq id 3 eq id 10 or eq id 23 eq id 27 or or eq id 34 eq id 37 eq id 38
end

fn fm_cu src view uchar 983040 tape view uint 262160 v ulong want ulong to bool
if ne js_type tape v jsnum
ret false
end
o = js_off tape v
if not js_isu src o
ret false
end
ret eq js_tou src o want
end

fn fm_cstr src view uchar 983040 tape view uint 262160 v ulong t view uchar * to bool
if ne js_type tape v jsstr
ret false
end
ret js_streq src js_off tape v t
end

note fm_full: layers with full attention and no RoPE (0, 1, 5, 9, ..., 45, 48)
fn fm_full ly ulong to bool
if le ly 1
ret true
end
if eq ly 48
ret true
end
ret and ge ly 5 eq rem ly 4 1
end

note fm_cstra: which 0 architectures ["FlintForCausalLM"], which 1 layer_types by fm_full
fn fm_cstra src view uchar 983040 tape view uint 262160 v ulong which ulong to bool
if ne js_type tape v jsarr
ret false
end
cnt = ulong 49
if eq which 0
cnt = 1
end
if ne js_nkids tape v cnt
ret false
end
e = js_first tape v
for i ulong cnt
if eq which 0
if not fm_cstr src tape e tarch
ret false
end
else
if fm_full i
if not fm_cstr src tape e tfull
ret false
end
else
if not fm_cstr src tape e tslide
ret false
end
end
end
e = js_enext tape e
end
ret true
end

fn fm_alen w ulong to ulong
if eq w 0
ret 4
end
if eq w 1
ret 2
end
ret 14
end

note fm_aval: which 0 eos_token_id, 1 mlp_only_layers, 2 no_rope_layer_indices (= the fm_full set)
fn fm_aval w ulong i ulong to ulong
if eq w 0
if eq i 0
ret 150001
end
if eq i 1
ret 150003
end
if eq i 2
ret 150005
end
ret 150018
end
if le i 1
ret i
end
if eq i 13
ret 48
end
ret sub mul i 4 3
end

fn fm_carr src view uchar 983040 tape view uint 262160 v ulong w ulong to bool
if ne js_type tape v jsarr
ret false
end
n = fm_alen w
if ne js_nkids tape v n
ret false
end
e = js_first tape v
for i ulong n
if not fm_cu src tape e fm_aval w i
ret false
end
e = js_enext tape e
end
ret true
end

note fm_mant: mantissa of the number lexeme src[p .. n): digits m and exponent bias 100000 minus
note the fraction digit count into gst 18 / 19, the end of the mantissa into gst 20
fn fm_mant src view uchar * p ulong n ulong to bool
if gt sub n p 64
ret false
end
if eq get src p 45
ret false
end
m = ulong 0
eb = ulong 100000
sig = ulong 0
fr = false
for i ulong sub n p
c = get src p
if eq c 46
fr = true
else
if or lt c 48 gt c 57
break
end
d = ulong sub c 48
if ne or m d 0
if ge sig 19
ret false
end
m = add mul m 10 d
sig = add sig 1
end
if fr
eb = sub eb 1
end
end
p = add p 1
end
put gst 18 m
put gst 19 eb
put gst 20 p
ret true
end

note fm_cexp: apply the exponent part src[q .. n) (q at e/E, or q == n) to the biased exponent in
note gst 19; 0 when the exponent has more than 4 digits (a real biased exponent is above 90000)
fn fm_cexp src view uchar 983040 q ulong n ulong to ulong
eb = get gst 19
if ge q n
ret eb
end
q = add q 1
ng = false
if eq get src q 45
ng = true
q = add q 1
else
if eq get src q 43
q = add q 1
end
end
if gt sub n q 4
ret 0
end
x = ulong 0
for i ulong sub n q
x = add mul x 10 ulong sub get src q 48
q = add q 1
end
if ng
ret sub eb x
end
ret add eb x
end

note fm_cdec: whether number token v equals wm * 10^(we - 100000) exactly (decimal normal form)
fn fm_cdec src view uchar 983040 tape view uint 262160 v ulong wm ulong we ulong to bool
if ne js_type tape v jsnum
ret false
end
p = js_off tape v
n = add p js_span tape v
if not fm_mant src p n
ret false
end
eb = fm_cexp src get gst 20 n
if eq eb 0
ret false
end
m = get gst 18
if eq m 0
ret eq wm 0
end
for i ulong 20
if ne rem m 10 0
break
end
m = div m 10
eb = add eb 1
end
ret and eq m wm eq eb we
end

fn fm_cval src view uchar 983040 tape view uint 262160 id ulong v ulong to bool
ty = js_type tape v
if eq id 0
ret fm_cstra src tape v 0
end
if eq id 1
ret fm_cstr src tape v tflint
end
if or eq id 2 eq id 32
ret eq ty jsfalse
end
if eq id 3
ret fm_cdec src tape v 0 0
end
if eq id 4
ret fm_cu src tape v FBOS
end
if eq id 5
ret fm_cu src tape v 1
end
if eq id 6
ret fm_carr src tape v 0
end
if eq id 7
ret fm_cu src tape v 128
end
if eq id 8
ret fm_cstr src tape v tsilu
end
if eq id 9
ret fm_cu src tape v 2048
end
if or eq id 10 eq id 27
ret eq ty jsnum
end
if eq id 11
ret fm_cu src tape v 6144
end
if eq id 12
ret fm_cstra src tape v 1
end
if eq id 13
ret fm_cu src tape v 262144
end
if eq id 14
ret fm_carr src tape v 1
end
if eq id 15
ret fm_cu src tape v 512
end
if or eq id 16 eq id 35
ret eq ty jstrue
end
if eq id 17
ret fm_cu src tape v 32
end
if eq id 18
ret fm_cu src tape v 256
end
if eq id 19
ret fm_cu src tape v 6
end
if eq id 20
ret fm_cu src tape v 49
end
if eq id 21
ret fm_cu src tape v 4
end
if eq id 22
ret fm_carr src tape v 2
end
if or eq id 23 eq id 34
ret or eq ty jstrue eq ty jsfalse
end
if eq id 24
ret fm_cu src tape v FPAD
end
if eq id 25
ret fm_cdec src tape v 1 99994
end
if eq id 26
ret fm_cdec src tape v 1 100004
end
if eq id 28
ret fm_cstr src tape v tsigm
end
if eq id 29
ret fm_cu src tape v 1024
end
if eq id 30
ret fm_cu src tape v 513
end
if eq id 31
ret fm_cstr src tape v tlearn
end
if eq id 33
ret fm_cstr src tape v tbf16
end
if eq id 36
ret fm_cu src tape v 150144
end
if eq id 37
ret eq ty jsstr
end
if eq id 38
ret eq ty jsnull
end
ret false
end

fn fm_cfg src view uchar 983040 tape edit uint 262160 n ulong to void
r = js_init tape n 64
if lt r 0
fm_die 10 tr10
end
r = js_parse src tape n
if lt r 0
fm_die 10 tr10
end
if ne js_type tape 0 jsobj
fm_die 10 tr10
end
sn = new uchar 64 0
k = js_first tape 0
while ne k jsnone bound 65536
id = fm_ckey src js_off tape k
if eq id FMX
fm_die 11 tr11
end
if ne get sn id 0
fm_die 11 tr11
end
put sn id 1
if not fm_cval src tape id add k 1
fm_die 11 tr11
end
k = js_mnext tape k
end
for i ulong 39
if eq get sn i 0
if not fm_copt i
fm_die 11 tr11
end
end
end
end

note ======== index scanner: a strict subset of JSON over gx (printable ASCII, no escapes) ========

fn fm_xws to void
p = get gst 7
n = get gst 8
for i ulong sub n p
c = get gx p
if not or or eq c 32 eq c 10 or eq c 13 eq c 9
break
end
p = add p 1
end
put gst 7 p
end

fn fm_xpk to ulong
fm_xws
p = get gst 7
if ge p get gst 8
ret 256
end
ret ulong get gx p
end

fn fm_xlit c ulong to void
if ne fm_xpk c
fm_die 21 tr21
end
put gst 7 add get gst 7 1
end

note fm_xstr: a string of 0..256 bytes in 32..126 without backslash; start in gst 15, length gst 16
fn fm_xstr to void
fm_xlit 34
p = get gst 7
n = get gst 8
s = p
for i ulong 257
if ge p n
fm_die 21 tr21
end
c = get gx p
if eq c 34
put gst 15 s
put gst 16 sub p s
put gst 7 add p 1
ret
end
if or or lt c 32 gt c 126 eq c 92
fm_die 21 tr21
end
p = add p 1
end
fm_die 21 tr21
end

fn fm_xeq t view uchar * to bool
o = get gst 15
if ne get gst 16 len t
ret false
end
for i ulong len t
if ne get gx add o i get t i
ret false
end
end
ret true
end

note fm_xuint: an unsigned JSON integer without leading zero, fraction, exponent or overflow
fn fm_xuint to ulong
fm_xws
p = get gst 7
n = get gst 8
s = p
m = ulong 0
for i ulong 21
if ge p n
break
end
c = get gx p
if or lt c 48 gt c 57
break
end
d = ulong sub c 48
if js_ovf10 m d
fm_die 21 tr21
end
m = add mul m 10 d
p = add p 1
end
if eq p s
fm_die 21 tr21
end
if and gt sub p s 1 eq get gx s 48
fm_die 21 tr21
end
if lt p n
c = get gx p
if or or eq c 46 eq c 101 or eq c 69 and ge c 48 le c 57
fm_die 21 tr21
end
end
put gst 7 p
ret m
end

fn fm_shc c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret or or eq c 46 eq c 95 eq c 45
end

fn fm_sheq j ulong o ulong n ulong to bool
for i ulong n
if ne get gsn add mul j 128 i get gx add o i
ret false
end
end
ret true
end

note fm_shid: shard file name of the last string: [A-Za-z0-9._-], 13..127 bytes, no leading '.',
note ending ".safetensors"; at most 64 shards; returns its shard index
fn fm_shid to ulong
o = get gst 15
n = get gst 16
if or lt n 13 gt n 127
fm_die 22 tr22
end
if eq get gx o 46
fm_die 22 tr22
end
for i ulong n
if not fm_shc get gx add o i
fm_die 22 tr22
end
end
b = sub add o n len tsuf
for i2 ulong len tsuf
if ne get gx add b i2 get tsuf i2
fm_die 22 tr22
end
end
k = get gst 13
for j ulong k
if eq get gsl j n
if fm_sheq j o n
ret j
end
end
end
if ge k 64
fm_die 22 tr22
end
for i3 ulong n
put gsn add mul k 128 i3 get gx add o i3
end
put gsl k n
put gst 13 add k 1
ret k
end

fn fm_xmeta to void
fm_xlit 123
fm_xstr
if not fm_xeq tktot
fm_die 21 tr21
end
fm_xlit 58
put gst 1 fm_xuint
fm_xlit 125
end

fn fm_xwmap nb edit uchar * to void
fm_xlit 123
if eq fm_xpk 125
put gst 7 add get gst 7 1
ret
end
while true bound 999999
fm_xstr
n = get gst 16
o = get gst 15
for i ulong n
put nb i get gx add o i
end
s = fm_slot nb n
if eq s FMX
fm_die 23 tr23
end
fm_xlit 58
fm_xstr
si = fm_shid
if ne get gix s 0
fm_die 24 tr24
end
put gix s uchar add si 1
put gst 0 add get gst 0 1
if eq fm_xpk 125
put gst 7 add get gst 7 1
ret
end
fm_xlit 44
end
fm_die 21 tr21
end

fn fm_index nb edit uchar * to void
fm_xlit 123
md = false
wm = false
while true bound 3
fm_xstr
if fm_xeq tkmeta
if md
fm_die 21 tr21
end
md = true
fm_xlit 58
fm_xmeta
else
if not fm_xeq tkwmap
fm_die 21 tr21
end
if wm
fm_die 21 tr21
end
wm = true
fm_xlit 58
fm_xwmap nb
end
if eq fm_xpk 125
break
end
fm_xlit 44
end
fm_xlit 125
fm_xws
if ne get gst 7 get gst 8
fm_die 21 tr21
end
if not and md wm
fm_die 21 tr21
end
end

fn fm_imiss to void
for s ulong FMNS
if fm_ok s
if eq get gix s 0
fm_die 26 tr26
end
end
end
end

fn fm_hmiss to void
for s ulong FMNS
if fm_ok s
if eq get gsee s 0
fm_die 41 tr41
end
end
end
end

note fm_snlt: shard name a sorts before shard name b (bytewise, shorter prefix first)
fn fm_snlt a ulong b ulong to bool
na = get gsl a
nb = get gsl b
for i ulong 128
if or ge i na ge i nb
ret lt na nb
end
ca = get gsn add mul a 128 i
cb = get gsn add mul b 128 i
if ne ca cb
ret lt ca cb
end
end
ret false
end

fn fm_sort to void
n = get gst 13
for i ulong n
put gord i i
end
for i2 ulong n
x = get gord i2
j = i2
while gt j 0 bound 65
if not fm_snlt x get gord sub j 1
break
end
put gord j get gord sub j 1
j = sub j 1
end
put gord j x
end
end

note ======== safetensors headers ========

fn fm_spath si ulong to ulong
dn = get gal 3
if or eq dn 0 gt dn 3900
fm_die 2 tr2
end
o = get gas 3
for i ulong dn
put gpth i get ga add o i
end
put gpth dn 47
n = get gsl si
for j ulong n
put gpth add add dn 1 j get gsn add mul si 128 j
end
ret add add dn 1 n
end

fn fm_eshp src view uchar * tape view uint * x ulong s ulong to void
if ne js_type tape x jsarr
fm_die 36 tr36
end
rk = fm_rk s
if ne js_nkids tape x rk
fm_die 36 tr36
end
e = js_first tape x
for i ulong rk
if ne js_type tape e jsnum
fm_die 36 tr36
end
o = js_off tape e
if not js_isu src o
fm_die 36 tr36
end
w = fm_d0 s
if eq i 1
w = fm_d1 s
end
if ne js_tou src o w
fm_die 36 tr36
end
e = js_enext tape e
end
end

fn fm_eoff src view uchar * tape view uint * x ulong s ulong to void
if ne js_type tape x jsarr
fm_die 37 tr37
end
if ne js_nkids tape x 2
fm_die 37 tr37
end
e = js_first tape x
f = js_enext tape e
if or ne js_type tape e jsnum ne js_type tape f jsnum
fm_die 37 tr37
end
if not and js_isu src js_off tape e js_isu src js_off tape f
fm_die 37 tr37
end
b = js_tou src js_off tape e
en = js_tou src js_off tape f
if gt b en
fm_die 37 tr37
end
if gt en get gst 11
fm_die 37 tr37
end
if ne sub en b mul 2 fm_np s
fm_die 37 tr37
end
c = get gst 12
put gbg c b
put gen c en
end

note fm_eval: entry v must be exactly {"dtype","shape","data_offsets"}, each once
fn fm_eval src view uchar * tape view uint * v ulong s ulong to void
if ne js_type tape v jsobj
fm_die 33 tr33
end
if ne js_nkids tape v 3
fm_die 33 tr33
end
f = ulong 0
k = js_first tape v
for i ulong 3
o = js_off tape k
x = add k 1
if js_streq src o tdtype
if ne and f 1 0
fm_die 33 tr33
end
f = or f 1
if ne js_type tape x jsstr
fm_die 35 tr35
end
if not js_streq src js_off tape x tbf16u
fm_die 35 tr35
end
else
if js_streq src o tshape
if ne and f 2 0
fm_die 33 tr33
end
f = or f 2
fm_eshp src tape x s
else
if not js_streq src o tdoff
fm_die 33 tr33
end
if ne and f 4 0
fm_die 33 tr33
end
f = or f 4
fm_eoff src tape x s
end
end
k = js_mnext tape k
end
end

fn fm_orow nb view uchar * n ulong s ulong c ulong to void
for i ulong n
fm_ob get nb i
end
fm_ob 9
si = get gst 10
for j ulong get gsl si
fm_ob get gsn add mul si 128 j
end
fm_ob 9
fm_otx tbf16u
fm_ob 9
fm_ou fm_d0 s
d1 = fm_d1 s
if ne d1 0
fm_ob 120
fm_ou d1
end
fm_ob 9
fm_ou get gbg c
fm_ob 9
fm_ou get gen c
fm_ob 10
end

note ======== load report hashing (om/vendor/sha256.om) ========

note fm_hfin: finish the running sha256 into ghs slot r (64 lowercase hex bytes)
fn fm_hfin r ulong to void
if not hfinal
fm_die 45 tr45
end
for i ulong 64
put ghs add mul r 64 i get hd i
end
end

note fm_hsh: sha256 of b[0 .. n) into ghs slot r
fn fm_hsh b view uchar * n ulong r ulong to void
hreset
for i ulong n
if not hpush get b i
fm_die 45 tr45
end
end
fm_hfin r
end

note fm_cls: report class of slot s: 0 embed, 1 final norm, 2 lm_head, 3 + per-layer kind 0..15,
note 19 + j routed expert projection (j 0 gate, 1 up, 2 down)
fn fm_cls s ulong to ulong
if lt s 3
ret s
end
k = fm_kd s
if lt k 16
ret add 3 k
end
ret add 19 rem sub k 16 3
end

note fm_acct: count slot s (extent c) into the tensor, parameter, routed and byte totals and into
note its report class
fn fm_acct s ulong c ulong to void
put gst 12 add c 1
put gst 6 add get gst 6 1
np = fm_np s
put gst 2 add get gst 2 np
if ge s 3
if ge fm_kd s 16
put gst 3 add get gst 3 np
end
end
nby = sub get gen c get gbg c
put gst 4 add get gst 4 nby
q = fm_cls s
put gkc q add get gkc q 1
put gkp q add get gkp q np
put gkb q add get gkb q nby
end

fn fm_entry src view uchar 983040 tape view uint 262160 nb edit uchar 256 k ulong to void
r = js_sget src js_off tape k nb
if lt r 0
fm_die 23 tr23
end
n = ulong r
if fm_rest nb n 0 tmeta
fm_die 34 tr34
end
s = fm_slot nb n
if eq s FMX
fm_die 23 tr23
end
if ne get gsee s 0
fm_die 39 tr39
end
if ne get gix s uchar add get gst 10 1
fm_die 40 tr40
end
c = get gst 12
if ge c len gbg
fm_die 42 tr42
end
fm_eval src tape add k 1 s
put gsee s uchar add get gst 10 1
put gsb s get gbg c
fm_acct s c
fm_orow nb n s c
end

note fm_tile: sort extents by begin; they must tile [0, data length) exactly
fn fm_tile to void
c = get gst 12
if eq c 0
fm_die 38 tr38
end
for i ulong c
b = get gbg i
en = get gen i
j = i
while gt j 0 bound 4097
if le get gbg sub j 1 b
break
end
put gbg j get gbg sub j 1
put gen j get gen sub j 1
j = sub j 1
end
put gbg j b
put gen j en
end
if ne get gbg 0 0
fm_die 38 tr38
end
for i2 ulong sub c 1
if ne get gbg add i2 1 get gen i2
fm_die 38 tr38
end
end
if ne get gen sub c 1 get gst 11
fm_die 38 tr38
end
end

fn fm_shard src edit uchar 983040 tape edit uint 262160 nb edit uchar 256 si ulong to void
fd = fm_open fm_spath si
sz = get gst 9
if lt sz 8
fm_die 30 tr30
end
r8 = pread int fd gh8 0 8 long 0
if ne r8 8
fm_die 3 tr3
end
hl = fm_h64
if or lt hl 2 gt hl len src
fm_die 31 tr31
end
if gt hl sub sz 8
fm_die 31 tr31
end
fm_pfull fd src hl 8
fm_close fd
if eq get gst 21 1
fm_hsh src hl si
put gsz si sz
put ghl si hl
end
put gst 10 si
put gst 11 sub sub sz 8 hl
put gst 12 0
r = js_init tape hl 64
if lt r 0
fm_die 32 tr32
end
r = js_parse src tape hl
if eq r neg long jsetok
fm_die 42 tr42
end
if lt r 0
fm_die 32 tr32
end
if ne js_type tape 0 jsobj
fm_die 33 tr33
end
k = js_first tape 0
while ne k jsnone bound 65536
fm_entry src tape nb k
k = js_mnext tape k
end
fm_tile
put gsc si get gst 12
end

note ======== expert layout (checked before the routed experts are fused) ========

note fm_lxe: the expert whose decimal name has the 3-place key k (digit + 1 per place, 0 past the
note end, so key order is the byte order of the names), FMX when k spells no expert 0..255
fn fm_lxe k ulong to ulong
a = div k 121
b = rem div k 11 11
c = rem k 11
if eq a 0
ret FMX
end
if and eq b 0 ne c 0
ret FMX
end
if and eq a 1 ne b 0
ret FMX
end
v = sub a 1
if ne b 0
v = add mul v 10 sub b 1
end
if ne c 0
v = add mul v 10 sub c 1
end
if ge v 256
ret FMX
end
ret v
end

note fm_xord: glx = the 256 experts in tensor name order (0, 1, 10, 100, 101, .., 99)
fn fm_xord to void
n = ulong 0
for k ulong 1331
e = fm_lxe k
if ne e FMX
if ge n 256
fm_die 44 tr44
end
put glx n e
n = add n 1
end
end
if ne n 256
fm_die 44 tr44
end
end

note fm_xone: projection j of expert e in MoE layer l must begin, inside its shard, exactly where
note the previous expert tensor of that layer in name order ended
fn fm_xone l ulong e ulong j ulong to void
s = add add 3 mul l 784 add 16 add mul e 3 j
sh = get gsee s
if eq sh 0
fm_die 44 tr44
end
x = sub ulong sh 1
b = get gsb s
cu = get gxc x
if and ne cu FMX ne b cu
fm_die 44 tr44
end
put gxc x add b mul 2 fm_np s
end

note fm_xlay: bind expert index to data offset before fusing. The safetensors writer lays a
note shard's tensors out in name order, so each MoE layer's 768 expert tensors (names .. .E.down,
note .E.gate, .E.up for E in name order) must tile every shard they occupy in that order. Names
note and shapes are bound per tensor (23, 36, 37); this binds the index to the bytes: two experts
note whose extents trade places, or any other permutation, refuses 44 before any forward math.
fn fm_xlay to void
fm_xord
for l ulong 47
for i ulong 64
put gxc i FMX
end
for k ulong 256
for jj ulong 3
fm_xone add l 2 get glx k rem add jj 2 3
end
end
end
end

note ======== load report ========

note fm_krec: the per-class accounts must reconcile with the running totals: tensors, parameters,
note routed parameters (classes 19..21), bytes, and bytes = 2 * parameters (BF16)
fn fm_krec to void
t = ulong 0
p = ulong 0
r = ulong 0
by = ulong 0
for q ulong 22
t = add t get gkc q
p = add p get gkp q
by = add by get gkb q
if ge q 19
r = add r get gkp q
end
end
if or ne t get gst 6 ne p get gst 2
fm_die 45 tr45
end
if or ne r get gst 3 ne by get gst 4
fm_die 45 tr45
end
if ne by mul 2 p
fm_die 45 tr45
end
end

fn fm_ohex r ulong to void
for i ulong 64
fm_ob get ghs add mul r 64 i
end
end

note fm_ofile: "file LABEL sha256 HEX bytes N" with the hash from ghs slot r
fn fm_ofile t view uchar * r ulong n ulong to void
fm_otx trfile
fm_otx t
fm_otx trsha
fm_ohex r
fm_otx tsby
fm_ou n
fm_ob 10
end

note fm_tpath: TOKDIR/t into gpth, its length
fn fm_tpath t view uchar * to ulong
dn = get gal 4
if or eq dn 0 gt dn 3900
fm_die 2 tr2
end
o = get gas 4
for i ulong dn
put gpth i get ga add o i
end
put gpth dn 47
for j ulong len t
put gpth add add dn 1 j get t j
end
ret add add dn 1 len t
end

note fm_hfile: stream TOKDIR/t through b into sha256 and write its file line
fn fm_hfile t view uchar * b edit uchar 983040 to void
fd = fm_open fm_tpath t
n = get gst 9
hreset
o = ulong 0
while lt o n bound 999999
m = sub n o
if gt m len b
m = len b
end
fm_pfull fd b m o
for i ulong m
if not hpush get b i
fm_die 45 tr45
end
end
o = add o m
end
fm_close fd
fm_hfin 67
fm_ofile t 67 n
end

note fm_hidx: sha256 of the admitted index bytes gx[0 .. gst 8) into slot 65
fn fm_hidx to void
hreset
n = get gst 8
o = ulong 0
while lt o n bound 999999
m = sub n o
if gt m 65536
m = 65536
end
for i ulong m
if not hpush get gx add o i
fm_die 45 tr45
end
end
o = add o m
end
fm_hfin 65
end

note fm_hinv: sha256 of the inventory TSV built in gob into slot 66 (loops stay under the bound)
fn fm_hinv to void
hreset
n = get gst 5
o = ulong 0
while lt o n bound 999999
m = sub n o
if gt m 65536
m = 65536
end
for i ulong m
if not hpush get gob add o i
fm_die 45 tr45
end
end
o = add o m
end
fm_hfin 66
end

note fm_octl: the control tokens config admission pinned (bos, pad, eos list)
fn fm_octl to void
fm_otx trctl
fm_ou FBOS
fm_otx trpad
fm_ou FPAD
fm_otx treos
for i ulong fm_alen 0
fm_ob 32
fm_ou fm_aval 0 i
end
fm_ob 10
end

fn fm_oshd si ulong to void
fm_otx trsh
for j ulong get gsl si
fm_ob get gsn add mul si 128 j
end
fm_otx tsby
fm_ou get gsz si
fm_otx trhdr
fm_ou get ghl si
fm_otx trsha
fm_ohex si
fm_otx trten
fm_ou get gsc si
fm_ob 10
end

fn fm_otk k ulong to void
if eq k 0
fm_otx tk0
end
if eq k 1
fm_otx tk1
end
if eq k 2
fm_otx tk2
end
if eq k 3
fm_otx tk3
end
if eq k 4
fm_otx tk4
end
if eq k 5
fm_otx tk5
end
if eq k 6
fm_otx tk6
end
if eq k 7
fm_otx tk7
end
if eq k 8
fm_otx tk8
end
if eq k 9
fm_otx tk9
end
if eq k 10
fm_otx tk10
end
if eq k 11
fm_otx tk11
end
if eq k 12
fm_otx tk12
end
if eq k 13
fm_otx tk13
end
if eq k 14
fm_otx tk14
end
if eq k 15
fm_otx tk15
end
end

note fm_okn: the name pattern of report class q (* for the layer and the expert index)
fn fm_okn q ulong to void
if eq q 0
fm_otx tembed
ret
end
if eq q 1
fm_otx tnorm
ret
end
if eq q 2
fm_otx tlmh
ret
end
fm_otx tlayers
fm_otx trstar
if lt q 19
fm_otk sub q 3
ret
end
fm_otx texp
fm_otx trstar
j = sub q 19
if eq j 0
fm_otx tgate
end
if eq j 1
fm_otx tup
end
if eq j 2
fm_otx tdown
end
end

fn fm_okind q ulong to void
fm_otx trkind
fm_okn q
fm_otx trten
fm_ou get gkc q
fm_otx tspar
fm_ou get gkp q
fm_otx tsby
fm_ou get gkb q
fm_ob 10
end

fn fm_otot to void
fm_otx trtot
fm_ou get gst 6
fm_otx tspar
fm_ou get gst 2
fm_otx tsrt
fm_ou get gst 3
fm_otx tsby
fm_ou get gst 4
fm_otx tssh
fm_ou get gst 13
fm_ob 10
end

note fm_rep: replace the inventory TSV on stdout with the load report (its sha256 is a report line)
fn fm_rep src edit uchar 983040 to void
ni = get gst 5
fm_hinv
fm_hidx
put gst 5 0
fm_otx trpv
fm_ob 10
fm_ofile trcfg 64 get gst 22
fm_ofile tridx 65 get gst 8
fm_hfile trtok src
fm_hfile trtkc src
fm_hfile trtpl src
fm_hfile trgen src
fm_ofile trinv 66 ni
fm_octl
for j ulong get gst 13
fm_oshd get gord j
end
for q ulong 22
fm_okind q
end
fm_otot
end

fn fm_summary to void
put gst 14 0
fm_etx tsok
fm_eu get gst 6
fm_etx tspar
fm_eu get gst 2
fm_etx tsrt
fm_eu get gst 3
fm_etx tssh
fm_eu get gst 13
fm_etx tsby
fm_eu get gst 4
fm_eput 10
fm_eflush
end

fn main to int
c = argcnt
if and ne c 4 ne c 5
fm_die 2 tr2
end
o = ulong 0
for i ulong ulong c
r = argread i ga o sub len ga o
if lt r 0
fm_die 2 tr2
end
put gas i o
put gal i ulong r
o = add o ulong r
end
src = new uchar 983040 0
tape = new uint 262160 0
nb = new uchar 256 0
if eq c 5
put gst 21 1
end
n = fm_rcfg src
if eq get gst 21 1
fm_hsh src n 64
put gst 22 n
end
fm_cfg src tape n
fm_ridx
fm_ohdr
fm_index nb
fm_imiss
fm_sort
for j ulong get gst 13
fm_shard src tape nb get gord j
end
fm_hmiss
fm_xlay
if ne get gst 4 get gst 1
fm_die 25 tr25
end
fm_krec
if eq get gst 21 1
fm_rep src
end
fm_oflush
fm_summary
ret 0
end
