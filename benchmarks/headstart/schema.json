{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aien-spark/aien-sovereign-core/benchmarks/headstart/schema.json",
  "title": "Headstart M0 build-baseline records (#532) and M5 A/B records (#536)",
  "description": "Schemas for manifest.json (headstart-manifest/v1) and each line of samples.jsonl (headstart-sample/v1) written by scripts/bench/headstart-aien.sh. summary.json (headstart-summary/v1) is derived from samples.jsonl by scripts/bench/headstart-summarize.sh.",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/sample" }
  ],
  "$defs": {
    "loadavg": {
      "type": "array",
      "description": "/proc/loadavg 1, 5 and 15 minute values",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "manifest": {
      "type": "object",
      "required": ["schema", "run_id", "created_at", "source", "toolchain", "host", "build", "protocol", "scenarios", "stages"],
      "properties": {
        "schema": { "const": "headstart-manifest/v1" },
        "run_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "source": {
          "type": "object",
          "required": ["commit", "short", "origin", "worktree", "worktree_kind"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "short": { "type": "string" },
            "origin": { "type": "string" },
            "worktree": { "type": "string", "description": "absolute path of the detached benchmark worktree" },
            "worktree_kind": { "type": "string" }
          }
        },
        "toolchain": {
          "type": "object",
          "required": ["rustc_vV", "cargo_V", "rust_toolchain_toml", "cargo_config_files", "env"],
          "properties": {
            "rustc_vV": { "type": "string", "description": "verbatim `rustc -vV` from the worktree root" },
            "cargo_V": { "type": "string", "description": "verbatim `cargo -V` from the worktree root" },
            "rust_toolchain_toml": { "type": "string" },
            "cargo_config_files": { "type": "array", "items": { "type": "string" } },
            "env": {
              "type": "object",
              "description": "build-relevant environment; the literal string <unset> when not set",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "host": {
          "type": "object",
          "required": ["arch", "kernel", "nproc", "cpu_models", "mem_total_kb", "mem_available_kb_at_setup", "disk_at_setup"],
          "properties": {
            "arch": { "type": "string", "description": "uname -m" },
            "kernel": { "type": "string" },
            "nproc": { "type": "integer" },
            "cpu_models": { "type": "array", "items": { "type": "string" } },
            "mem_total_kb": { "type": "integer" },
            "mem_available_kb_at_setup": { "type": "integer" },
            "disk_at_setup": { "type": "string" }
          }
        },
        "build": {
          "type": "object",
          "required": ["features", "profiles", "target_dir", "jobs", "cold_definition", "registry_cache"],
          "properties": {
            "features": { "type": "string" },
            "profiles": { "type": "object", "additionalProperties": { "type": "string" } },
            "target_dir": { "type": "string" },
            "jobs": { "type": "string" },
            "cold_definition": { "type": "string" },
            "registry_cache": {
              "type": "object",
              "required": ["state", "how", "fetch_wall_s"],
              "properties": {
                "state": { "enum": ["warm"] },
                "how": { "type": "string" },
                "fetch_wall_s": { "type": "number" }
              }
            }
          }
        },
        "protocol": {
          "type": "object",
          "required": ["samples_per_scenario", "load1_max", "load_wait_cap_s", "foreign_monitor_interval_s", "max_reruns_when_contaminated", "slow_cold_threshold_s", "foreign_definition", "contaminated_definition", "time_v_available"],
          "properties": {
            "samples_per_scenario": { "type": "integer" },
            "samples_reduced": {
              "type": "object",
              "properties": { "to": { "type": "integer" }, "reason": { "type": "string" } }
            },
            "cold_rounds_run": { "type": "integer" },
            "load1_max": { "type": "number" },
            "load_wait_cap_s": { "type": "integer" },
            "foreign_monitor_interval_s": { "type": "integer" },
            "max_reruns_when_contaminated": { "type": "integer" },
            "slow_cold_threshold_s": { "type": "integer" },
            "foreign_definition": { "type": "string" },
            "contaminated_definition": { "type": "string" },
            "time_v_available": { "type": "boolean" },
            "quiet_flag": {
              "type": "object",
              "description": "enabled, tool, available and wait_cap_s are absent in runs made before the quiet-flag cap (baseline-20261015-4c83e38)",
              "properties": {
                "enabled": { "type": "boolean", "description": "HS_QUIETLOCK=1" },
                "tool": { "type": "string" },
                "available": { "type": "boolean", "description": "the quietlock tool was found on PATH" },
                "respected": { "type": "boolean", "description": "enabled and available; false means the flag was not checked" },
                "wait_cap_s": { "type": "integer", "description": "longest wait for the flag before proceeding with the sample marked contaminated" },
                "how": { "type": "string" },
                "first_stage": { "type": "string" }
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "command", "cwd"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["timings", "cold", "prime", "incremental", "settle"] },
              "command": { "type": "string", "description": "exact command line, run with CARGO_TARGET_DIR set to build.target_dir" },
              "cwd": { "type": "string" }
            }
          }
        },
        "incremental": {
          "type": "object",
          "required": ["command", "steps", "series_per_kind", "order", "body", "iface", "reason"],
          "properties": {
            "command": { "type": "string" },
            "steps": { "type": "integer" },
            "series_per_kind": { "type": "integer" },
            "order": { "type": "string" },
            "body": { "type": "object" },
            "iface": { "type": "object" },
            "reason": { "type": "string" }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "started_at", "script"],
            "properties": {
              "stage": { "type": "string" },
              "started_at": { "type": "string" },
              "ended_at": { "type": "string" },
              "script": { "type": "string" }
            }
          }
        },
        "cleanup": { "type": "object" }
      }
    },
    "sample": {
      "type": "object",
      "required": ["schema", "run_id", "sample_id", "scenario", "arm", "kind", "round", "step", "attempt", "aa_pair", "prep", "edit", "command", "cwd", "cargo_target_dir", "started_at", "wall_s", "time_v", "exit_status", "ok", "loadavg_before", "loadavg_after", "load_wait_s", "load_wait_capped", "mem_available_kb_before", "foreign", "contaminated", "final", "log_tail"],
      "properties": {
        "schema": { "const": "headstart-sample/v1" },
        "run_id": { "type": "string" },
        "sample_id": { "type": "string", "description": "<scenario>-<arm>-r<round>-s<step>-a<attempt>" },
        "scenario": { "type": "string" },
        "arm": { "enum": ["A", "B", "OFF", "ON"], "description": "A/B: B exists only for an A/A pair (in the M5 ab stage A and B both run the OFF environment). OFF/ON: M5 (#536) arm environments HS_ARM_ENV_OFF and HS_ARM_ENV_ON of one toolchain" },
        "kind": { "enum": ["timings", "cold", "prime", "incremental", "settle", "ab", "verify"] },
        "cargo_bin": { "type": "string", "description": "M5: cargo binary that ran the command (HS_CARGO); absent in M0 samples" },
        "env_words": { "type": "string", "description": "M5: KEY=VALUE words added to the command environment (RUSTC, arm environment, verify extras); absent in M0 samples" },
        "round": { "type": "integer" },
        "step": { "type": "integer", "description": "incremental edit step (1..steps), 0 otherwise" },
        "attempt": { "type": "integer", "minimum": 1 },
        "aa_pair": { "type": ["string", "null"] },
        "prep": { "enum": ["cold", "warm"], "description": "cold = CARGO_TARGET_DIR removed before this attempt" },
        "edit": { "type": ["string", "null"], "description": "exact edit applied for incremental samples" },
        "command": { "type": "string" },
        "cwd": { "type": "string" },
        "cargo_target_dir": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "wall_s": { "type": "number", "description": "wall clock seconds from date +%s%N around the command" },
        "time_v": {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean", "description": "false when /usr/bin/time is missing; other fields are then absent" },
            "reason": { "type": "string" },
            "max_rss_kb": { "type": ["integer", "null"] },
            "cpu_percent": { "type": ["number", "null"] },
            "user_s": { "type": ["number", "null"] },
            "sys_s": { "type": ["number", "null"] },
            "elapsed": { "type": "string" },
            "exit_status": { "type": ["integer", "null"] },
            "max_rss_scope": { "type": "string" }
          }
        },
        "exit_status": { "type": "integer" },
        "ok": { "type": "boolean", "description": "exit_status == 0; failed samples are never counted in medians" },
        "loadavg_before": { "$ref": "#/$defs/loadavg" },
        "loadavg_after": { "$ref": "#/$defs/loadavg" },
        "quiet_flag_wait_s": { "type": "integer", "description": "seconds waited for the host quiet flag (quietlock); absent on samples taken before the runner checked it" },
        "quiet_flag_checked": { "type": "boolean", "description": "false when the quiet flag was disabled or the tool was missing; absent in runs before the cap" },
        "quiet_flag_wait_capped": { "type": "boolean", "description": "true when the flag was still held at protocol.quiet_flag.wait_cap_s; the sample is then contaminated" },
        "load_wait_s": { "type": "integer" },
        "load_wait_capped": { "type": "boolean", "description": "true when the 1-minute load never fell below protocol.load1_max within the cap" },
        "mem_available_kb_before": { "type": ["integer", "null"] },
        "foreign": {
          "type": "object",
          "required": ["at_start", "monitor_ticks", "max_seen", "seen"],
          "properties": {
            "at_start": { "type": "array", "items": { "type": "string", "description": "pid:comm:crate" } },
            "at_end": { "type": "array", "items": { "type": "string" }, "description": "snapshot right after the command ended; absent in runs before it was added" },
            "monitor_ticks": { "type": "integer", "description": "checks made every protocol.foreign_monitor_interval_s while the command ran" },
            "max_seen": { "type": "integer" },
            "seen": { "type": "array", "items": { "type": "string" } }
          }
        },
        "contaminated": { "type": "boolean", "description": "true when contamination_reasons is non-empty (in older runs: a foreign process at start or at a tick)" },
        "contamination_reasons": {
          "type": "array",
          "items": { "enum": ["foreign_at_start", "foreign_during", "foreign_at_end", "load_wait_capped", "quiet_flag_wait_capped", "quiet_hold_not_taken"] }
        },
        "quiet_hold": {
          "type": "object",
          "description": "M5: per-sample quietlock hold (HS_HOLD=1) around the load wait and the timed command; absent in earlier samples",
          "required": ["requested", "held", "id", "acquire_s", "refused"],
          "properties": {
            "requested": { "type": "boolean" },
            "held": { "type": "boolean", "description": "false when not requested, or when the hold was not taken (then the sample is contaminated: quiet_hold_not_taken)" },
            "id": { "type": ["string", "null"], "description": "quietlock hold id (QUIETLOCK_HOLD)" },
            "acquire_s": { "type": "integer", "description": "seconds from the first hold attempt to holding it" },
            "refused": { "type": "integer", "description": "hold attempts refused with exit 75 (another job took the flag first)" }
          }
        },
        "ice_reports": { "type": "integer", "description": "M5: rustc-ice-*.txt reports (internal compiler error) the sample left in the worktree root; their heads are appended to log_tail and the files removed; absent in earlier samples" },
        "final": { "type": "boolean", "description": "false when this attempt was contaminated and re-run" },
        "log_tail": { "type": "string", "description": "path, relative to the run directory, of the kept log tail; for a failed sample in M5 runs it starts with the error lines of the full log" }
      }
    }
  }
}
