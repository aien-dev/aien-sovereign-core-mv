# tests/gates/sc-native-identity.gate
# Mirrors hosted: ci.yml verify 'bash scripts/test-native-identity.sh' (build-script refusals: stub under
# AIEN_REQUIRE_NATIVE_LIBS, missing library, prebuilt archive without, with a wrong or with a truncated
# sha256, missing ABI symbol, omega checkout at the wrong commit; no omega needed)
gate: SC-NATIVE-IDENTITY
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - native-artifacts.lock
  - omega.lock
  - cudapp.lock
  - scripts/test-native-identity.sh
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/aien-abi-conformance/
  - crates/aien-omega-compose/
  - crates/aien-omega-gpu/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["native-identity"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
