# tests/gates/sc-pins-selftest.gate
# target_lock: none because aien-audit-inputs traced no cargo or rustc in this gate (L335, 2026-10-21).
# cache: inputs_complete because aien-audit-inputs found every file this gate reads declared (L335).
# Mirrors hosted: ci.yml verify 'bash scripts/test-pins.sh'
gate: SC-PINS-SELFTEST
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - scripts/pins.sh
  - scripts/test-pins.sh
  - omega.lock
  - cudapp.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["pins-selftest"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
target_lock: none
cache: inputs_complete
