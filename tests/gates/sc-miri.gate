# tests/gates/sc-miri.gate
# Mirrors hosted: hardening.yml miri: cargo +nightly miri test for aien-capability and aien-kv-cache + run_mutants.sh miri (hosted 1622 s)
# requires: host only. The nightly toolchain with miri and a prebuilt miri sysroot are seeded read-only into the sandbox by tools/aien-local-ci/install.sh (#600), so the run needs no network and no operator step.
gate: SC-MIRI
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - crates/aien-capability/
  - crates/aien-kv-cache/
  - crates/aien-replay/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["miri"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: machine
