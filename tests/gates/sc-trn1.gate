# tests/gates/sc-trn1.gate
# Mirrors hosted: hardening.yml trn1: aien-replay trn1_conformance with the aien-protocols corpus at 353b7d4 + run_mutants.sh trn1 (hosted 50 s)
# cache: inputs_complete: the corpus is a sibling pinned by sha in tests/gates/run.sh (an input); crates/aien-replay is its own
# cargo workspace, and aien-audit-inputs (L335) found it reads only the crates listed below.
gate: SC-TRN1
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - crates/aien-replay/
  - crates/aien-platform/
  - crates/aien-platform-linux/
  - crates/aien-kv-cache/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["trn1"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
cache: inputs_complete
