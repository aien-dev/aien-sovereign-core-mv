# tests/gates/sc-aien-verify-tests.gate
# Mirrors hosted: ci.yml verify 'sh tools/aien-verify/tests/run.sh'
gate: SC-AIEN-VERIFY-TESTS
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - tools/aien-verify/
  - docs/campaigns/whole-system-e2e/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["aien-verify-tests"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
