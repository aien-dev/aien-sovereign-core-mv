# tests/gates/sc-install.gate
# Mirrors hosted: ci.yml verify 'bash scripts/test-install.sh'
gate: SC-INSTALL
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - scripts/
  - install.sh
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["install-test"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
