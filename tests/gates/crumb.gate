# tests/gates/crumb.gate
# Mirrors hosted: no hosted crumb job in this repository; crumb verify . is the always-run structural check
# cache: never because crumbs live in many directories and inputs are literal paths; the check is sub-second.
gate: CRUMB-VERIFY
manifest_version: 2
owner: aien-sovereign-core
requires:
  - portable
inputs:
  - .crumb
  - crumb.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crumb-verify"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
cache: never
